---
import { getCollection } from 'astro:content';

interface Props {
  currentPath: string;
}

const { currentPath: rawPath } = Astro.props;
const currentPath = rawPath === '/' ? '/' : rawPath.replace(/\/$/, '');

const buffers = [
  { path: '/', file: 'index.astro', icon: 'astro' },
  { path: '/about', file: 'about.astro', icon: 'astro' },
  { path: '/experience', file: 'experience.astro', icon: 'astro' },
  { path: '/projects', file: 'projects.astro', icon: 'astro' },
  { path: '/skills', file: 'skills.astro', icon: 'astro' },
  { path: '/certificates', file: 'certificates.astro', icon: 'astro' },
  { path: '/blog', file: 'blog.astro', icon: 'astro' },
  { path: '/contact', file: 'contact.astro', icon: 'astro' },
];
const treeFiles = buffers;

let activeFile = 'index.astro';
let activeIcon: 'astro' | 'mdx' | 'json' = 'astro';
const blogSlug = currentPath.match(/^\/blog\/(.+)$/);
if (blogSlug) {
  activeFile = `blog/${blogSlug[1]}.mdx`;
  activeIcon = 'mdx';
} else if (currentPath === '/package-json') {
  activeFile = 'package.json';
  activeIcon = 'json';
} else {
  const match = buffers.find((b) => b.path === currentPath);
  if (match) {
    activeFile = match.file;
    activeIcon = match.icon as 'astro' | 'mdx' | 'json';
  }
}

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const astroIcon = `
  <svg viewBox="0 0 85 107" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M27.59 91.14c-4.83-4.42-6.25-13.7-4.23-20.43 3.49 4.25 8.33 5.6 13.35 6.36 7.74 1.18 15.34.74 22.53-2.78.82-.4 1.58-.93 2.48-1.47.67 1.96.85 3.94.61 5.96-.57 4.9-3.02 8.69-6.91 11.58-1.56 1.15-3.2 2.18-4.81 3.27-4.93 3.34-6.27 7.26-4.41 12.92.04.14.08.28.18.62-2.52-1.13-4.36-2.78-5.76-4.95-1.48-2.29-2.18-4.83-2.22-7.55-.02-1.33-.02-2.66-.2-3.97-.44-3.19-1.95-4.61-4.79-4.69-2.91-.08-5.21 1.75-5.82 5.15Z"/>
    <path fill="currentColor" d="M0 69.67s14.33-6.97 28.71-6.97L39.55 29.23c.41-1.63 1.6-2.73 2.94-2.73 1.35 0 2.54 1.1 2.95 2.73L56.27 62.7c17.03 0 28.71 6.97 28.71 6.97S60.64 3.39 60.59 3.25C59.89 1.3 58.71 0 57.11 0H27.88c-1.6 0-2.74 1.3-3.49 3.25C24.34 3.39 0 69.67 0 69.67Z"/>
  </svg>
`;
---

<div class="nvim-shell">
  <div class="nvim-titlebar">
    <button
      class="nvim-tree-trigger"
      type="button"
      aria-controls="nvimtree"
      aria-expanded="false"
      aria-label="Open file explorer"
      data-tree-drawer-toggle
    >
      <span aria-hidden="true">☰</span>
      <span>NvimTree</span>
    </button>
    <span>nvim - portfolio/src/{activeFile}</span>
  </div>

  <div class="nvim-bufferline">
    {buffers.map((buf, i) => (
      <div
        class:list={['nvim-buffer', { active: currentPath === buf.path }]}
        data-path={buf.path}
        hidden={currentPath !== buf.path}
      >
        <a href={buf.path} class="buf-link">
          <span class="buf-num">{i + 1}</span>
          <span class:list={['buf-icon', buf.icon === 'mdx' ? 'icon-mdx' : 'icon-astro']}>
            {buf.icon === 'astro' ? <Fragment set:html={astroIcon} /> : 'MDX'}
          </span>
          <span>{buf.file.replace('blog/', '')}</span>
        </a>
        <button type="button" class="buf-close" data-buf-close aria-label={`Close ${buf.file}`}>×</button>
      </div>
    ))}
    {blogSlug && (
      <div class="nvim-buffer active" data-path={currentPath}>
        <a href={currentPath} class="buf-link">
          <span class="buf-num">{buffers.length + 1}</span>
          <span class="buf-icon icon-mdx">MDX</span>
          <span>{blogSlug[1]}.mdx</span>
        </a>
        <button type="button" class="buf-close" data-buf-close aria-label="Close buffer">×</button>
      </div>
    )}
    {currentPath === '/package-json' && (
      <div class="nvim-buffer active" data-path="/package-json">
        <a href='/package-json' class="buf-link">
          <span class="buf-num">{buffers.length + 1}</span>
          <span class="buf-icon icon-json">JSON</span>
          <span>package.json</span>
        </a>
        <button type="button" class="buf-close" data-buf-close aria-label="Close package.json">×</button>
      </div>
    )}
  </div>

  <div class="nvim-main">
    <button class="nvimtree-backdrop" type="button" aria-label="Close file explorer" data-tree-drawer-close></button>
    <nav class="nvimtree" id="nvimtree" aria-label="File explorer">
      <div class="nvimtree-header"> NvimTree</div>
      <div class="nvimtree-body">
        <div class="tree-folder">
          <span class="tree-caret" aria-hidden="true">v</span>
          <span>portfolio</span>
        </div>
        <a
          href='/package-json'
          class:list={['tree-file tree-indent-1', { 'tree-active': currentPath === '/package-json' }]}
        >
          <span class="tree-icon icon-json">JSON</span>
          <span>package.json</span>
        </a>
        <div class="tree-folder tree-indent-1">
          <span class="tree-caret" aria-hidden="true">v</span>
          <span>src</span>
        </div>
        <div>
            {treeFiles.map((buf) => (
              <a
                href={buf.path}
                class:list={['tree-file tree-indent-2', { 'tree-active': currentPath === buf.path }]}
              >
                <span class:list={['tree-icon', buf.icon === 'mdx' ? 'icon-mdx' : 'icon-astro']}>
                  {buf.icon === 'astro' ? <Fragment set:html={astroIcon} /> : 'MDX'}
                </span>
                <span>{buf.file}</span>
              </a>
            ))}
            <button class="tree-folder tree-indent-2" type="button" data-tree-toggle="blog-posts" aria-expanded="true">
              <span class="tree-caret" aria-hidden="true">v</span>
              <span>blog-posts</span>
            </button>
            <div data-tree-group="blog-posts">
              {posts.map((post) => (
                <a
                  href={`/blog/${post.id}`}
                  class:list={['tree-file tree-indent-3', { 'tree-active': currentPath === `/blog/${post.id}` }]}
                >
                  <span class="tree-icon icon-mdx">MDX</span>
                  <span>{post.id}.mdx</span>
                </a>
              ))}
            </div>
            <div class="tree-folder tree-indent-2">&gt; <span>data</span></div>
            <div class="tree-folder tree-indent-2">&gt; <span>components</span></div>
            <div class="tree-folder tree-indent-2">&gt; <span>layouts</span></div>
          </div>
          <div class="tree-folder tree-indent-1">&gt; <span>public</span></div>
          <div class="tree-folder tree-indent-1">&gt; <span>node_modules</span></div>
      </div>
    </nav>

    <div class="nvim-editor-wrap">
      <div class="nvim-winbar">
        <span class="winbar-root">portfolio</span>
        {activeIcon !== 'json' && <span class="winbar-sep"> &gt; </span>}
        {activeIcon !== 'json' && <span>src</span>}
        <span class="winbar-sep"> &gt; </span>
        <span class="winbar-file">{activeFile}</span>
      </div>

      <div class="nvim-editor">
        <slot />
      </div>
    </div>
  </div>

  <div class="nvim-statusline">
    <div class="sl-a"> NORMAL</div>
    <div class="sl-b">
      <svg class="branch-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0zm0 2.122a2.25 2.25 0 1 0-1.5 0v.878A2.25 2.25 0 0 0 5.75 8.5h1.5v2.128a2.251 2.251 0 1 0 1.5 0V8.5h1.5a2.25 2.25 0 0 0 2.25-2.25v-.878a2.25 2.25 0 1 0-1.5 0v.878a.75.75 0 0 1-.75.75h-4.5A.75.75 0 0 1 5 6.25v-.878zm3.75 7.378a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0zm3-8.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0z"/>
      </svg>
      main
    </div>
    <div class="sl-c">~/portfolio/src/{activeFile}</div>
    <div class="sl-spacer"></div>
    <div class="sl-x"> utf-8</div>
    <div class="sl-x-div"></div>
    <div class="sl-x sl-filetype">
      {activeIcon === 'mdx' && <span class="sl-ft-icon icon-mdx">MDX</span>}
      {activeIcon === 'json' && <span class="sl-ft-icon icon-json">JSON</span>}
      {activeIcon === 'astro' && <span class="sl-ft-icon icon-astro" set:html={astroIcon}></span>}
      <span>{activeIcon === 'mdx' ? 'MDX' : activeIcon === 'json' ? 'JSON' : 'Astro'}</span>
    </div>
    <div class="sl-x-div"></div>
    <div class="sl-x" id="sl-pct"> Top</div>
    <div class="sl-x-div"></div>
    <div class="sl-y" id="sl-pos"> 1:1</div>
  </div>
</div>

<style>
  .nvim-shell {
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
    background: var(--color-nvim-bg-hard);
    font-family: var(--font-mono);
  }

  .nvim-titlebar {
    position: relative;
    background: var(--color-nvim-bg-hard);
    padding: 4px 14px;
    text-align: center;
    font-size: 11px;
    color: var(--color-nvim-fg3);
    border-bottom: 1px solid var(--color-nvim-bg);
    flex-shrink: 0;
  }
  .nvim-tree-trigger {
    display: none;
    align-items: center;
    gap: 6px;
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
    border: 1px solid var(--color-nvim-bg3);
    background: var(--color-nvim-bg1);
    color: var(--color-nvim-fg2);
    padding: 1px 7px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    cursor: pointer;
  }
  .nvim-tree-trigger:hover,
  .nvim-tree-trigger[aria-expanded='true'] {
    color: var(--color-nvim-yellow);
    border-color: var(--color-nvim-yellow);
  }
  .nvim-tree-trigger:focus-visible {
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: 2px;
  }

  .nvim-bufferline {
    display: flex;
    background: var(--color-nvim-bg);
    border-bottom: 1px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    overflow-x: auto;
  }
  .nvim-bufferline::-webkit-scrollbar { display: none; }

  .nvim-buffer {
    display: flex;
    align-items: center;
    font-size: 12px;
    color: var(--color-nvim-fg3);
    border-right: 1px solid var(--color-nvim-bg-hard);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s;
  }
  .nvim-buffer[hidden] { display: none; }
  .nvim-buffer:hover { color: var(--color-nvim-fg2); }
  .nvim-buffer.active {
    background: var(--color-nvim-bg1);
    color: var(--color-nvim-fg);
    border-top: 2px solid var(--color-nvim-yellow);
  }

  .buf-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 6px 5px 14px;
    color: inherit;
    text-decoration: none;
  }
  .nvim-buffer.active .buf-link { padding-top: 3px; }

  .buf-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-right: 8px;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--color-nvim-fg3);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.12s, background 0.12s, color 0.12s;
  }
  .nvim-buffer:hover .buf-close,
  .nvim-buffer.active .buf-close { opacity: 1; }
  .buf-close:hover {
    background: var(--color-nvim-bg3);
    color: var(--color-nvim-red, var(--color-nvim-yellow));
  }
  .buf-close:focus-visible {
    opacity: 1;
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: -1px;
  }

  .buf-num { font-size: 9px; color: var(--color-nvim-bg3); }
  .nvim-buffer.active .buf-num { color: var(--color-nvim-fg3); }

  .nvim-main {
    position: relative;
    display: flex;
    flex: 1;
    overflow: hidden;
  }
  .nvimtree-backdrop {
    display: none;
  }

  .nvimtree {
    width: 210px;
    background: var(--color-nvim-bg);
    border-right: 2px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    overflow-y: auto;
    font-size: 12px;
  }
  .nvimtree::-webkit-scrollbar { width: 3px; }
  .nvimtree::-webkit-scrollbar-thumb { background: var(--color-nvim-bg3); }

  .nvimtree-header {
    padding: 5px 10px;
    font-size: 11px;
    color: var(--color-nvim-fg3);
    border-bottom: 1px solid var(--color-nvim-bg1);
    letter-spacing: 0.05em;
  }

  .tree-folder {
    display: flex;
    align-items: center;
    gap: 5px;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 2px 10px;
    color: var(--color-nvim-aqua);
    font-size: 12px;
    line-height: 1.8;
    cursor: pointer;
    font-family: var(--font-mono);
    text-align: left;
  }
  .tree-folder:hover {
    background: var(--color-nvim-bg1);
  }
  .tree-folder:not(button) {
    cursor: default;
  }
  .tree-folder:not(button):hover {
    background: transparent;
  }
  .tree-folder:focus-visible {
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: -1px;
  }
  .tree-caret {
    width: 10px;
    flex-shrink: 0;
    color: var(--color-nvim-fg3);
  }
  [data-tree-group][hidden] {
    display: none;
  }
  .tree-file {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    color: var(--color-nvim-fg2);
    font-size: 12px;
    line-height: 1.8;
    text-decoration: none;
    transition: background 0.1s;
  }
  .tree-file:hover { background: var(--color-nvim-bg1); }
  .tree-file.tree-active {
    background: var(--color-nvim-bg2);
    color: var(--color-nvim-fg);
  }

  .tree-indent-1 { padding-left: 20px; }
  .tree-indent-2 { padding-left: 32px; }
  .tree-indent-3 { padding-left: 44px; }
  .tree-indent-4 { padding-left: 56px; }

  .buf-icon,
  .tree-icon {
    font-size: 9px;
    font-weight: 700;
    width: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .icon-astro {
    color: var(--color-nvim-orange);
  }
  .icon-astro :global(svg) {
    width: 13px;
    height: 13px;
    display: block;
  }
  .icon-mdx { color: var(--color-nvim-purple); }

  .nvim-editor-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .nvim-winbar {
    background: var(--color-nvim-bg1);
    padding: 3px 14px;
    font-size: 12px;
    color: var(--color-nvim-fg3);
    border-bottom: 1px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0;
  }
  .winbar-root { color: var(--color-nvim-aqua); }
  .winbar-sep { color: var(--color-nvim-bg3); margin: 0 6px; }
  .winbar-file { color: var(--color-nvim-yellow); }

  .nvim-editor {
    flex: 1;
    overflow-y: auto;
    background: var(--color-nvim-bg);
    padding: 24px 28px;
    font-family: var(--font-sans);
  }
  .nvim-editor::-webkit-scrollbar { width: 4px; }
  .nvim-editor::-webkit-scrollbar-thumb { background: var(--color-nvim-bg3); }

  .nvim-statusline {
    display: flex;
    align-items: stretch;
    font-size: 12px;
    height: 22px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .sl-a,
  .sl-b,
  .sl-c,
  .sl-x,
  .sl-y {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .sl-a {
    background: var(--color-nvim-yellow);
    color: var(--color-nvim-bg);
    padding: 0 12px;
    font-weight: 700;
  }
  .sl-b {
    background: var(--color-nvim-bg3);
    color: var(--color-nvim-fg);
    padding: 0 10px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .branch-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }
  .sl-c {
    background: var(--color-nvim-bg1);
    color: var(--color-nvim-fg2);
    padding: 0 10px;
    font-size: 11px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-spacer { flex: 1; background: var(--color-nvim-bg1); }
  .sl-filetype { gap: 5px; }
  .sl-ft-icon {
    font-size: 9px;
    font-weight: 700;
    width: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sl-ft-icon.icon-astro { color: var(--color-nvim-orange); }
  :global(.sl-ft-icon.icon-astro svg) { width: 11px; height: 11px; display: block; }
  .sl-ft-icon.icon-mdx { color: var(--color-nvim-purple); }
  .sl-ft-icon.icon-json { color: var(--color-nvim-yellow); width: auto; }
  .sl-ft-icon.icon-mdx { width: auto; }
  .icon-json { color: var(--color-nvim-yellow); }
  .sl-x-div {
    width: 1px;
    background: var(--color-nvim-bg);
    flex-shrink: 0;
  }
  .sl-x {
    background: var(--color-nvim-bg3);
    color: var(--color-nvim-fg);
    padding: 0 10px;
  }
  .sl-y {
    background: var(--color-nvim-yellow);
    color: var(--color-nvim-bg);
    padding: 0 10px;
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .nvim-titlebar {
      padding-left: 100px;
      padding-right: 10px;
      text-align: left;
    }

    .nvim-titlebar > span {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .nvim-tree-trigger {
      display: inline-flex;
    }

    .nvim-bufferline {
      min-height: 31px;
    }

    .nvim-buffer {
      padding-left: 10px;
      padding-right: 10px;
      max-width: 140px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .nvimtree {
      position: absolute;
      inset: 0 auto 0 0;
      z-index: 20;
      width: min(82vw, 300px);
      border-right: 2px solid var(--color-nvim-yellow);
      box-shadow: 18px 0 40px rgba(0, 0, 0, 0.55);
      transform: translateX(-100%);
      transition: transform 0.18s ease;
    }

    .nvim-shell.tree-drawer-open .nvimtree {
      transform: translateX(0);
    }

    .nvimtree-backdrop {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 10;
      border: 0;
      background: rgba(10, 8, 5, 0.58);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.18s ease;
    }

    .nvim-shell.tree-drawer-open .nvimtree-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .nvim-editor {
      padding: 14px;
    }

    :global(.nvim-editor main) {
      padding-left: 0;
      padding-right: 0;
    }

    .sl-c {
      display: none;
    }

    .sl-b,
    .sl-x,
    .sl-x-div {
      display: none;
    }
  }
</style>

<script>
  function initNvimTreeDrawer() {
    const shell = document.querySelector<HTMLElement>('.nvim-shell');
    const trigger = document.querySelector<HTMLButtonElement>('[data-tree-drawer-toggle]');
    const closeButton = document.querySelector<HTMLButtonElement>('[data-tree-drawer-close]');
    const tree = document.getElementById('nvimtree');
    if (!shell || !trigger || !closeButton || !tree) return;
    if (trigger.dataset.bound === 'true') return;
    trigger.dataset.bound = 'true';

    function setOpen(isOpen: boolean) {
      shell.classList.toggle('tree-drawer-open', isOpen);
      trigger.setAttribute('aria-expanded', String(isOpen));
      trigger.setAttribute('aria-label', isOpen ? 'Close file explorer' : 'Open file explorer');
    }

    trigger.addEventListener('click', () => {
      setOpen(!shell.classList.contains('tree-drawer-open'));
    });

    closeButton.addEventListener('click', () => setOpen(false));

    tree.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && shell.classList.contains('tree-drawer-open')) {
        setOpen(false);
      }
    });
  }

  function applyTreeState(toggle: HTMLButtonElement, expanded: boolean) {
    const key = toggle.dataset.treeToggle;
    if (!key) return;
    const group = document.querySelector<HTMLElement>(`[data-tree-group="${key}"]`);
    if (!group) return;
    toggle.setAttribute('aria-expanded', String(expanded));
    group.hidden = !expanded;
    const caret = toggle.querySelector<HTMLElement>('.tree-caret');
    if (caret) caret.textContent = expanded ? 'v' : '>';
  }

  function initNvimTree() {
    document.querySelectorAll<HTMLButtonElement>('[data-tree-toggle]').forEach((toggle) => {
      const key = toggle.dataset.treeToggle;
      if (!key) return;

      const stored = sessionStorage.getItem(`tree:${key}`);
      const expanded = stored === null ? toggle.getAttribute('aria-expanded') !== 'false' : stored === 'true';
      applyTreeState(toggle, expanded);

      if (toggle.dataset.bound === 'true') return;
      toggle.dataset.bound = 'true';

      toggle.addEventListener('click', () => {
        const isExpanded = toggle.getAttribute('aria-expanded') !== 'false';
        applyTreeState(toggle, !isExpanded);
        sessionStorage.setItem(`tree:${key}`, String(!isExpanded));
      });
    });
  }

  function initStatusline() {
    const editor = document.querySelector<HTMLElement>('.nvim-editor');
    const pctEl = document.getElementById('sl-pct');
    const posEl = document.getElementById('sl-pos');
    if (!editor || !pctEl || !posEl) return;

    function update() {
      const scrollTop = editor.scrollTop;
      const scrollHeight = editor.scrollHeight - editor.clientHeight;
      const line = Math.max(1, Math.round(scrollTop / 20) + 1);
      posEl.textContent = `${line}:1`;
      if (scrollHeight <= 0 || scrollTop === 0) {
        pctEl.textContent = ' Top';
      } else if (scrollTop >= scrollHeight - 1) {
        pctEl.textContent = ' Bot';
      } else {
        pctEl.textContent = ` ${Math.round((scrollTop / scrollHeight) * 100)}%`;
      }
    }

    editor.removeEventListener('scroll', update);
    editor.addEventListener('scroll', update, { passive: true });
    update();
  }

  const OPENED_KEY = 'nvim:opened-buffers';

  function getOpened(): string[] {
    try {
      return JSON.parse(sessionStorage.getItem(OPENED_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function setOpened(paths: string[]) {
    sessionStorage.setItem(OPENED_KEY, JSON.stringify(paths));
  }

  function initBuffers() {
    const bufferline = document.querySelector<HTMLElement>('.nvim-bufferline');
    if (!bufferline) return;

    // Visiting a page opens its buffer (like editing a file in vim).
    const current = bufferline.querySelector<HTMLElement>('.nvim-buffer.active');
    const currentPath = current?.dataset.path;
    let opened = getOpened();
    if (currentPath && !opened.includes(currentPath)) {
      opened.push(currentPath);
      setOpened(opened);
    }

    // Show only buffers that have been opened this session; the active one always shows.
    bufferline.querySelectorAll<HTMLElement>('.nvim-buffer').forEach((tab) => {
      const path = tab.dataset.path;
      tab.hidden = !(path && opened.includes(path)) && !tab.classList.contains('active');
    });

    if (bufferline.dataset.bound === 'true') return;
    bufferline.dataset.bound = 'true';

    bufferline.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-buf-close]');
      if (!btn) return;
      e.preventDefault();
      const tab = btn.closest<HTMLElement>('.nvim-buffer');
      const path = tab?.dataset.path;
      if (!tab || !path) return;

      setOpened(getOpened().filter((p) => p !== path));

      const wasActive = tab.classList.contains('active');
      const all = [...bufferline.querySelectorAll<HTMLElement>('.nvim-buffer')];
      const idx = all.indexOf(tab);
      tab.hidden = true;

      if (wasActive) {
        // Jump to the nearest still-open tab: right first, then left; home if none left.
        const neighbor =
          all.slice(idx + 1).find((t) => !t.hidden) ||
          all.slice(0, idx).reverse().find((t) => !t.hidden);
        const target = neighbor?.querySelector<HTMLAnchorElement>('.buf-link');
        window.location.href = target ? target.href : '/';
      }
    });
  }

  initNvimTreeDrawer();
  initNvimTree();
  initStatusline();
  initBuffers();
  document.addEventListener('astro:page-load', initNvimTreeDrawer);
  document.addEventListener('astro:page-load', initNvimTree);
  document.addEventListener('astro:page-load', initStatusline);
  document.addEventListener('astro:page-load', initBuffers);
</script>
