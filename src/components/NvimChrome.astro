  .nvim-help-sub {
    color: var(--color-nvim-fg2);
    margin: 10px 0 4px;
  }
  .nvim-help dl {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 3px 14px;
    margin: 0;
  }
  .nvim-help dt {
    color: var(--color-nvim-yellow);
  }
  .nvim-help dd {
    color: var(--color-nvim-fg2);
    margin: 0;
  }
  .nvim-help-hint {
    color: var(--color-nvim-fg2);
    margin-top: 12px;
  }

  @media (min-width: 761px) {
    .nvim-shell.tree-hidden .nvimtree {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .nvim-titlebar {
      padding-left: 100px;
      padding-right: 10px;
      text-align: left;
    }

    .nvim-titlebar > span {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .nvim-bufferline {
      min-height: 31px;
    }

    .nvim-buffer {
      padding-left: 10px;
      padding-right: 10px;
      max-width: 140px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .nvimtree {
      position: absolute;
      inset: 0 auto 0 0;
      z-index: 20;
      width: min(82vw, 300px);
      border-right: 2px solid var(--color-nvim-yellow);
      box-shadow: 18px 0 40px rgba(0, 0, 0, 0.55);
      transform: translateX(-100%);
      transition: transform 0.18s ease;
    }

    .nvim-shell.tree-drawer-open .nvimtree {
      transform: translateX(0);
    }

    .nvimtree-backdrop {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 10;
      border: 0;
      background: rgba(10, 8, 5, 0.58);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.18s ease;
    }

    .nvim-shell.tree-drawer-open .nvimtree-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .nvim-editor {
      padding: 14px;
    }

    :global(.nvim-editor main) {
      padding-left: 0;
      padding-right: 0;
