    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cmd-msg.error {
    color: var(--color-nvim-red);
  }
  /* The empty cmdheight row is clickable: it opens the command line, the mouse equivalent of : */
  .nvim-cmdline-row:has(> .nvim-cmdline[hidden]) {
    cursor: text;
  }
  /* wildoptions=pum: completion popup above the command line, gruvbox Pmenu / PmenuSel */
  .cmd-pum {
    position: absolute;
    bottom: 100%;
    left: 10px;
    z-index: 50;
    min-width: 18ch;
    max-height: 60vh;
    overflow-y: auto;
