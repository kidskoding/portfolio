---
import { getCollection } from 'astro:content';
import type { Tab } from '../lib/nvim-actions';
import Bufferline from './nvim/Bufferline';
import Cmdline from './nvim/Cmdline';
import Explorer from './nvim/Explorer';
import Help from './nvim/Help';
import Statusline from './nvim/Statusline';
import TreeTrigger from './nvim/TreeTrigger';
import VimLayer from './nvim/VimLayer';

interface Props {
  currentPath: string;
}

const { currentPath: rawPath } = Astro.props;
const currentPath = rawPath === '/' ? '/' : rawPath.replace(/\/$/, '');

const buffers: Tab[] = [
  { path: '/', file: 'index.astro', icon: 'astro' },
  { path: '/about', file: 'about.astro', icon: 'astro' },
  { path: '/experience', file: 'experience.astro', icon: 'astro' },
  { path: '/projects', file: 'projects.astro', icon: 'astro' },
  { path: '/skills', file: 'skills.astro', icon: 'astro' },
  { path: '/certificates', file: 'certificates.astro', icon: 'astro' },
  { path: '/blog', file: 'index.mdx', icon: 'mdx', dir: 'blog-posts' },
  { path: '/contact', file: 'contact.astro', icon: 'astro' },
  { path: '/license', file: 'license.astro', icon: 'astro' },
];
// buffers with a dir live in that explorer folder, not at the top of src/
const treeFiles = buffers.filter((b) => !b.dir);
const blogIndex = buffers.find((b) => b.path === '/blog') as Tab;
type TabIcon = Tab['icon'];

let activeFile = 'index.astro';
let activeIcon: TabIcon = 'astro';
const blogSlug = currentPath.match(/^\/blog\/(.+)$/);
const projectSlug = currentPath.match(/^\/projects\/(.+)$/);
if (blogSlug) {
  activeFile = `blog-posts/${blogSlug[1]}.mdx`;
  activeIcon = 'mdx';
} else if (projectSlug) {
  activeFile = `projects/${projectSlug[1]}.mdx`;
  activeIcon = 'mdx';
} else if (currentPath === '/package-json') {
  activeFile = 'package.json';
  activeIcon = 'json';
} else if (currentPath === '/checkhealth') {
  activeFile = 'health://';
  activeIcon = 'checkhealth';
} else {
  const match = buffers.find((b) => b.path === currentPath);
  if (match) {
    activeFile = match.dir ? `${match.dir}/${match.file}` : match.file;
    activeIcon = match.icon;
  }
}

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const projects = (await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft)).sort((a, b) =>
  a.id.localeCompare(b.id),
);

const tabs: Tab[] = [
  ...buffers,
  { path: '/package-json', file: 'package.json', icon: 'json' },
  { path: '/checkhealth', file: 'health://', icon: 'checkhealth' },
  ...posts.map((post): Tab => ({ path: `/blog/${post.id}`, file: `${post.id}.mdx`, icon: 'mdx' })),
  ...projects.map((project): Tab => ({ path: `/projects/${project.id}`, file: `${project.id}.mdx`, icon: 'mdx' })),
];
// package.json sits at the repo root and health:// is a scratch buffer, so neither is under src/
const inSrc = activeIcon !== 'json' && activeIcon !== 'checkhealth';
---

<div class="nvim-shell">
  <div class="nvim-titlebar">
    <TreeTrigger client:load />
    <span>
      nvim -{' '}
      <span class:list={{ 'file-label': currentPath === '/' }}>
        {activeIcon === 'checkhealth' ? activeFile : `portfolio/src/${activeFile}`}
      </span>
      {currentPath === '/' && <span class="noname-text">[No Name]</span>}
    </span>
  </div>

  <div class="nvim-main">
    <Explorer
      client:load
      files={treeFiles}
      blogIndex={blogIndex}
      posts={posts.map((post) => post.id)}
      projects={projects.map((project) => project.id)}
      currentPath={currentPath}
    />

    <div class="nvim-editor-wrap">
      <Bufferline client:load tabs={tabs} currentPath={currentPath} />

      <div class="nvim-winbar">
        <span class="winbar-root">portfolio</span>
        {inSrc && <span class="winbar-sep"> &gt; </span>}
        {inSrc && <span>src</span>}
        <span class="winbar-sep"> &gt; </span>
        <span class="winbar-file">{activeFile}</span>
      </div>

      <div class="nvim-editor">
        <slot />
      </div>
    </div>
  </div>

  <Statusline
    client:load
    file={activeIcon === 'checkhealth' ? activeFile : (activeFile.split('/').pop() ?? activeFile)}
    icon={activeIcon}
    isIndex={currentPath === '/'}
  />

  <Cmdline client:load />
</div>

<Help client:load />
<VimLayer client:load />

<style is:global>
  .nvim-shell {
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
    background: var(--color-nvim-bg-hard);
    font-family: var(--font-mono);
  }

  .nvim-titlebar {
    position: relative;
    background: var(--color-nvim-bg-hard);
    padding: 4px 14px;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-nvim-fg2);
    border-bottom: 1px solid var(--color-nvim-bg);
    flex-shrink: 0;
  }
  .nvim-tree-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
    border: 1px solid var(--color-nvim-bg3);
    background: var(--color-nvim-bg1);
    color: var(--color-nvim-fg2);
    padding: 1px 7px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.4;
    cursor: pointer;
  }
  /* Highlight follows the shell's tree state, which is right in the server HTML, so it never flickers on navigation */
  .nvim-tree-trigger:hover,
  .nvim-shell.tree-drawer-open .nvim-tree-trigger {
    color: var(--color-nvim-yellow);
    border-color: var(--color-nvim-yellow);
  }
  @media (min-width: 761px) {
    .nvim-shell:not(.tree-hidden) .nvim-tree-trigger {
      color: var(--color-nvim-yellow);
      border-color: var(--color-nvim-yellow);
    }
  }
  .nvim-tree-trigger:focus-visible {
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: 2px;
  }

  .nvim-bufferline {
    display: flex;
    background: var(--color-nvim-bg);
    border-bottom: 1px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }
  .nvim-bufferline::-webkit-scrollbar {
    display: none;
  }

  .nvim-buffer {
    display: flex;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-nvim-fg2);
    border-right: 1px solid var(--color-nvim-bg-hard);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s;
  }
  .nvim-buffer[hidden] {
    display: none;
  }
  .nvim-buffer:hover {
    color: var(--color-nvim-fg2);
  }
  .nvim-buffer.active {
    background: var(--color-nvim-bg1);
    color: var(--color-nvim-fg);
    border-top: 2px solid var(--color-nvim-yellow);
  }

  .buf-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 6px 5px 14px;
    color: inherit;
    text-decoration: none;
  }
  .nvim-buffer.active .buf-link {
    padding-top: 3px;
  }

  .buf-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-right: 8px;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--color-nvim-fg3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.12s,
      background 0.12s,
      color 0.12s;
  }
  .nvim-buffer:hover .buf-close,
  .nvim-buffer.active .buf-close {
    opacity: 1;
  }
  .buf-close:hover {
    background: var(--color-nvim-bg3);
    color: var(--color-nvim-red, var(--color-nvim-yellow));
  }
  .buf-close:focus-visible {
    opacity: 1;
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: -1px;
  }

  .nvim-main {
    position: relative;
    display: flex;
    flex: 1;
    overflow: hidden;
  }
  .nvimtree-backdrop {
    display: none;
  }

  .nvimtree {
    width: 320px;
    background: var(--color-nvim-bg);
    border-right: 2px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    overflow-y: auto;
    font-size: var(--text-sm);
  }
  .nvimtree::-webkit-scrollbar {
    width: 3px;
  }
  .nvimtree::-webkit-scrollbar-thumb {
    background: var(--color-nvim-bg3);
  }

  .tree-folder {
    display: flex;
    align-items: center;
    gap: 5px;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 2px 10px;
    color: var(--color-nvim-blue);
    font-size: var(--text-sm);
    line-height: 1.8;
    cursor: pointer;
    font-family: var(--font-mono);
    text-align: left;
  }
  .tree-folder:hover {
    background: var(--color-nvim-bg1);
  }
  .tree-folder:not(button) {
    cursor: default;
  }
  .tree-folder:not(button):hover {
    background: transparent;
  }
  .tree-folder:focus-visible {
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: -1px;
  }
  .tree-caret {
    width: 10px;
    flex-shrink: 0;
    color: var(--color-nvim-fg3);
  }
  [data-tree-group][hidden] {
    display: none;
  }
  .tree-file {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    color: var(--color-nvim-fg2);
    font-size: var(--text-sm);
    line-height: 1.8;
    text-decoration: none;
    transition: background 0.1s;
  }
  .tree-file:hover {
    background: var(--color-nvim-bg1);
  }
  .tree-file.tree-active {
    background: var(--color-nvim-bg2);
    color: var(--color-nvim-fg);
  }

  .tree-indent-1 {
    padding-left: 20px;
  }
  .tree-indent-2 {
    padding-left: 32px;
  }
  .tree-indent-3 {
    padding-left: 44px;
  }
  .tree-indent-4 {
    padding-left: 56px;
  }

  .buf-icon,
  .tree-icon {
    font-family: 'JetBrains Mono Nerd Font Icons', var(--font-mono);
    font-size: var(--text-base);
    font-weight: 400;
    width: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .icon-astro {
    color: var(--color-devicon-astro);
  }
  .icon-mdx {
    color: var(--color-devicon-mdx);
  }
  /* package.json is the only JSON buffer; devicons colors it by filename */
  .icon-json {
    color: var(--color-devicon-package-json);
  }
  .icon-checkhealth {
    color: var(--color-devicon-checkhealth);
  }

  /* While the home intro shows, index.astro is a fresh [No Name] buffer, like nvim right after launch */
  .noname-label,
  .noname-text {
    display: none;
  }
  html[data-intro='on'] .noname-text {
    display: inline;
  }
  html[data-intro='on'] .nvim-buffer[data-path='/'] .buf-close,
  html[data-intro='on'] .file-label,
  html[data-intro='on'] .nvim-winbar,
  html[data-intro='on'] .sl-file-info {
    display: none;
  }
  html[data-intro='on'] .nvim-buffer[data-path='/'] .buf-link {
    padding-right: 14px;
  }
  html[data-intro='on'] .noname-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  html[data-intro='on'] .tree-file.tree-active:not(:hover) {
    background: transparent;
    color: var(--color-nvim-fg2);
  }
  .noname-icon {
    width: 22px;
    height: 14px;
    flex-shrink: 0;
    color: var(--color-devicon-default);
  }

  .nvim-editor-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .nvim-winbar {
    background: var(--color-nvim-bg1);
    padding: 3px 14px;
    font-size: var(--text-sm);
    color: var(--color-nvim-fg2);
    border-bottom: 1px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0;
  }
  .winbar-root {
    color: var(--color-nvim-blue);
  }
  .winbar-sep {
    color: var(--color-nvim-fg3);
    margin: 0 6px;
  }
  .winbar-file {
    color: var(--color-nvim-yellow);
  }

  .nvim-editor {
    flex: 1;
    overflow-y: auto;
    background: var(--color-nvim-bg);
    padding: 24px 28px;
    font-family: var(--font-sans);
  }
  .nvim-editor::-webkit-scrollbar {
    width: 4px;
  }
  .nvim-editor::-webkit-scrollbar-thumb {
    background: var(--color-nvim-bg3);
  }

  .nvim-statusline {
    display: flex;
    align-items: stretch;
    font-size: var(--text-sm);
    font-weight: 700;
    height: 22px;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--color-nvim-bg2);
    --sl-mode: var(--color-nvim-blue);
  }
  .nvim-statusline[data-mode='INSERT'] {
    --sl-mode: var(--color-nvim-green);
  }
  .nvim-statusline[data-mode='VISUAL'] {
    --sl-mode: var(--color-nvim-purple);
  }
  .nvim-statusline[data-mode='COMMAND'] {
    --sl-mode: var(--color-nvim-orange);
  }

  /* lualine layout: a/z take the mode color, b/y bg3, c/x bg2 */
  .sl-a,
  .sl-b,
  .sl-c,
  .sl-x,
  .sl-y,
  .sl-z {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding: 0 10px;
  }
  .sl-a,
  .sl-z {
    background: var(--sl-mode);
    color: var(--color-nvim-bg);
    font-weight: 700;
    transition: background 0.12s ease;
  }
  .sl-a {
    padding: 0 12px;
  }
  .sl-b,
  .sl-y {
    background: var(--color-nvim-bg3);
    color: var(--color-nvim-fg);
    gap: 5px;
  }
  .sl-b {
    color: var(--sl-mode);
    transition: color 0.12s ease;
  }
  .branch-icon {
    font-family: 'JetBrains Mono Nerd Font Icons', var(--font-mono);
    font-size: var(--text-base);
    font-weight: 400;
    flex-shrink: 0;
  }
  .sl-c {
    color: var(--color-nvim-fg2);
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-spacer {
    flex: 1;
  }
  .sl-x {
    color: var(--color-nvim-fg2);
  }
  .sl-x-div {
    display: flex;
    align-items: center;
    color: var(--color-nvim-fg3);
    flex-shrink: 0;
  }
  .sl-filetype {
    gap: 6px;
  }
  .sl-ft-icon {
    font-size: var(--text-base);
    font-family: 'JetBrains Mono Nerd Font Icons', var(--font-mono);
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sl-ft-icon.icon-astro {
    color: var(--color-devicon-astro);
  }
  .sl-ft-icon.icon-mdx {
    color: var(--color-devicon-mdx);
  }
  .sl-ft-icon.icon-json {
    color: var(--color-devicon-package-json);
  }
  .sl-ft-icon.icon-checkhealth {
    color: var(--color-devicon-checkhealth);
  }

  .sl-showcmd {
    color: var(--color-nvim-fg2);
    padding: 0 8px;
    min-width: 0;
  }
  .sl-showcmd:empty {
    display: none;
  }
  .sl-help {
    background: none;
    border: 0;
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }
  .sl-help:hover {
    color: var(--color-nvim-fg);
  }

  /* cmdheight=1: the row always exists under the statusline, empty until the command line or a message fills it.
     The row itself is never [hidden]: Tailwind preflight's layered [hidden] { display: none !important } can't be
     overridden from here, so hiding toggles the inner .nvim-cmdline instead. */
  .nvim-cmdline-row {
    height: 22px;
    flex-shrink: 0;
    background: var(--color-nvim-bg-hard);
  }
  .nvim-cmdline {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 100%;
    padding: 0 10px;
    font-size: var(--text-sm);
    color: var(--color-nvim-fg);
  }
  .cmd-prompt {
    color: var(--color-nvim-fg);
  }
  .cmd-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: 0;
    padding: 0;
    color: var(--color-nvim-fg);
    font: inherit;
    caret-color: var(--color-nvim-yellow);
  }
  .cmd-msg {
    color: var(--color-nvim-fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cmd-msg.error {
    color: var(--color-nvim-red);
  }
  /* The empty cmdheight row is clickable: it opens the command line, the mouse equivalent of : */
  .nvim-cmdline-row:has(> .nvim-cmdline[hidden]) {
    cursor: text;
  }
  /* wildoptions=pum: completion popup above the command line */
  .cmd-pum {
    position: absolute;
    bottom: 100%;
    left: 10px;
    z-index: 50;
    min-width: 18ch;
    max-height: 60vh;
    overflow-y: auto;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-nvim-bg2);
    color: var(--color-nvim-fg);
  }
  .cmd-pum[hidden] {
    display: none;
  }
  .cmd-pum li {
    padding: 0 1ch;
    line-height: 22px;
    white-space: nowrap;
    cursor: pointer;
  }
  .cmd-pum li:hover,
  .cmd-pum li[aria-selected='true'] {
    background: var(--color-nvim-blue);
    color: var(--color-nvim-bg2);
    font-weight: 700;
  }

  .nvim-help {
    position: fixed;
    inset: 0;
    z-index: 9100;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
  }
  .nvim-help[hidden] {
    display: none;
  }
  .nvim-help-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(10, 8, 5, 0.75);
    cursor: default;
  }
  .nvim-help-panel {
    position: relative;
    width: 460px;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    background: var(--color-nvim-bg1);
    border: 1px solid var(--color-nvim-bg3);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
    padding: 14px 18px;
    font-size: var(--text-sm);
  }
  .nvim-help-title {
    color: var(--color-nvim-green);
    font-weight: 700;
    margin-bottom: 8px;
  }
  .nvim-help-sub {
    color: var(--color-nvim-fg2);
    margin: 10px 0 4px;
  }
  .nvim-help dl {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 3px 14px;
    margin: 0;
  }
  .nvim-help dt {
    color: var(--color-nvim-yellow);
  }
  .nvim-help dd {
    color: var(--color-nvim-fg2);
    margin: 0;
  }
  .nvim-help-hint {
    color: var(--color-nvim-fg2);
    margin-top: 12px;
  }

  @media (min-width: 761px) {
    .nvim-shell.tree-hidden .nvimtree {
      display: none;
    }
  }

  @media (max-width: 760px) {
    /* The trigger sits in the flow here, so the title starts after it whatever the button's width */
    .nvim-titlebar {
      display: flex;
      align-items: center;
      gap: 10px;
      padding-left: 8px;
      padding-right: 10px;
      text-align: left;
    }
    .nvim-tree-trigger {
      position: static;
      transform: none;
      flex-shrink: 0;
    }

    .nvim-titlebar > span {
      display: block;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .nvim-bufferline {
      min-height: 31px;
    }

    /* Long names ellipsize inside the tab so the icon and close button never get clipped */
    .buf-name {
      display: inline-block;
      max-width: 18ch;
      overflow: hidden;
      text-overflow: ellipsis;
      vertical-align: bottom;
    }

    .nvimtree {
      position: absolute;
      inset: 0 auto 0 0;
      z-index: 20;
      width: min(82vw, 300px);
      border-right: 2px solid var(--color-nvim-yellow);
      box-shadow: 18px 0 40px rgba(0, 0, 0, 0.55);
      transform: translateX(-100%);
      transition: transform 0.18s ease;
    }

    .nvim-shell.tree-drawer-open .nvimtree {
      transform: translateX(0);
    }

    .nvimtree-backdrop {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 10;
      border: 0;
      background: rgba(10, 8, 5, 0.58);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.18s ease;
    }

    .nvim-shell.tree-drawer-open .nvimtree-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .nvim-editor {
      padding: 14px;
    }

    .nvim-editor main {
      padding-left: 0;
      padding-right: 0;
    }

    .sl-c {
      display: none;
    }

    .sl-b,
    .sl-x,
    .sl-x-div {
      display: none;
    }
  }
</style>
