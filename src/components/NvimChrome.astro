---
import { getCollection } from 'astro:content';
import { devicons } from '../data/devicons';

interface Props {
  currentPath: string;
}

const { currentPath: rawPath } = Astro.props;
const currentPath = rawPath === '/' ? '/' : rawPath.replace(/\/$/, '');

const buffers = [
  { path: '/', file: 'index.astro', icon: 'astro' },
  { path: '/about', file: 'about.astro', icon: 'astro' },
  { path: '/experience', file: 'experience.astro', icon: 'astro' },
  { path: '/projects', file: 'projects.astro', icon: 'astro' },
  { path: '/skills', file: 'skills.astro', icon: 'astro' },
  { path: '/certificates', file: 'certificates.astro', icon: 'astro' },
  { path: '/blog', file: 'blog.astro', icon: 'astro' },
  { path: '/contact', file: 'contact.astro', icon: 'astro' },
];
const treeFiles = buffers;
type TabIcon = 'astro' | 'mdx' | 'json' | 'checkhealth';
interface Tab {
  path: string;
  file: string;
  icon: TabIcon;
}

let activeFile = 'index.astro';
let activeIcon: TabIcon = 'astro';
const blogSlug = currentPath.match(/^\/blog\/(.+)$/);
const projectSlug = currentPath.match(/^\/projects\/(.+)$/);
if (blogSlug) {
  activeFile = `blog/${blogSlug[1]}.mdx`;
  activeIcon = 'mdx';
} else if (projectSlug) {
  activeFile = `projects/${projectSlug[1]}.mdx`;
  activeIcon = 'mdx';
} else if (currentPath === '/package-json') {
  activeFile = 'package.json';
  activeIcon = 'json';
} else if (currentPath === '/checkhealth') {
  activeFile = 'health://';
  activeIcon = 'checkhealth';
} else {
  const match = buffers.find((b) => b.path === currentPath);
  if (match) {
    activeFile = match.file;
    activeIcon = match.icon as TabIcon;
  }
}

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.id.localeCompare(b.id));

const tabs: Tab[] = [
  ...(buffers as Tab[]),
  { path: '/package-json', file: 'package.json', icon: 'json' },
  { path: '/checkhealth', file: 'health://', icon: 'checkhealth' },
  ...posts.map((post): Tab => ({ path: `/blog/${post.id}`, file: `${post.id}.mdx`, icon: 'mdx' })),
  ...projects.map((project): Tab => ({ path: `/projects/${project.id}`, file: `${project.id}.mdx`, icon: 'mdx' })),
];
// package.json sits at the repo root and health:// is a scratch buffer, so neither is under src/
const inSrc = activeIcon !== 'json' && activeIcon !== 'checkhealth';
---

<div class="nvim-shell">
  <div class="nvim-titlebar">
    <button
      class="nvim-tree-trigger"
      type="button"
      aria-controls="nvimtree"
      aria-expanded="false"
      aria-label="Open file explorer"
      data-tree-drawer-toggle
    >
      <span aria-hidden="true">☰</span>
      <span>NvimTree</span>
    </button>
    <span>
      nvim -{' '}
      <span class:list={{ 'file-label': currentPath === '/' }}>
        {activeIcon === 'checkhealth' ? activeFile : `portfolio/src/${activeFile}`}
      </span>
      {currentPath === '/' && <span class="noname-text">[No Name]</span>}
    </span>
  </div>

  <div class="nvim-main">
    <button class="nvimtree-backdrop" type="button" aria-label="Close file explorer" data-tree-drawer-close></button>
    <nav class="nvimtree" id="nvimtree" aria-label="File explorer">
      <div class="nvimtree-body">
        <div class="tree-folder">
          <span class="tree-caret" aria-hidden="true">
            v
          </span>
          <span>portfolio</span>
        </div>
        <a
          href="/package-json"
          class:list={['tree-file tree-indent-1', { 'tree-active': currentPath === '/package-json' }]}
        >
          <span class="tree-icon icon-json">{devicons.json}</span>
          <span>package.json</span>
        </a>
        <div class="tree-folder tree-indent-1">
          <span class="tree-caret" aria-hidden="true">
            v
          </span>
          <span>src</span>
        </div>
        <div>
          {treeFiles.map((buf) => (
            <a href={buf.path} class:list={['tree-file tree-indent-2', { 'tree-active': currentPath === buf.path }]}>
              <span class:list={['tree-icon', `icon-${buf.icon}`]}>{devicons[buf.icon as TabIcon]}</span>
              <span>{buf.file}</span>
            </a>
          ))}
          <button class="tree-folder tree-indent-2" type="button" data-tree-toggle="blog-posts" aria-expanded="true">
            <span class="tree-caret" aria-hidden="true">
              v
            </span>
            <span>blog-posts</span>
          </button>
          <div data-tree-group="blog-posts">
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class:list={['tree-file tree-indent-3', { 'tree-active': currentPath === `/blog/${post.id}` }]}
              >
                <span class="tree-icon icon-mdx">{devicons.mdx}</span>
                <span>{post.id}.mdx</span>
              </a>
            ))}
          </div>
          <button class="tree-folder tree-indent-2" type="button" data-tree-toggle="projects" aria-expanded="false">
            <span class="tree-caret" aria-hidden="true">
              &gt;
            </span>
            <span>projects</span>
          </button>
          <div data-tree-group="projects" hidden>
            {projects.map((project) => (
              <a
                href={`/projects/${project.id}`}
                class:list={['tree-file tree-indent-3', { 'tree-active': currentPath === `/projects/${project.id}` }]}
              >
                <span class="tree-icon icon-mdx">{devicons.mdx}</span>
                <span>{project.id}.mdx</span>
              </a>
            ))}
          </div>
          <div class="tree-folder tree-indent-2">
            &gt; <span>data</span>
          </div>
          <div class="tree-folder tree-indent-2">
            &gt; <span>components</span>
          </div>
          <div class="tree-folder tree-indent-2">
            &gt; <span>layouts</span>
          </div>
        </div>
        <div class="tree-folder tree-indent-1">
          &gt; <span>public</span>
        </div>
        <div class="tree-folder tree-indent-1">
          &gt; <span>node_modules</span>
        </div>
      </div>
    </nav>

    <div class="nvim-editor-wrap">
      <div class="nvim-bufferline">
        {tabs.map((tab) => (
          <div
            class:list={['nvim-buffer', { active: currentPath === tab.path }]}
            data-path={tab.path}
            hidden={currentPath !== tab.path}
          >
            <a href={tab.path} class="buf-link">
              <span class:list={['buf-icon', `icon-${tab.icon}`, { 'file-label': tab.path === '/' }]}>
                {devicons[tab.icon]}
              </span>
              {tab.path === '/' && (
                <span class="noname-label">
                  <svg class="noname-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3.5 1.5h6l3 3v10h-9z" stroke="currentColor" />
                    <path d="M9.5 1.5v3h3M5.5 8h5M5.5 10.5h5M5.5 13h3" stroke="currentColor" />
                  </svg>
                  [No Name]
                </span>
              )}
              <span class:list={{ 'file-label': tab.path === '/' }}>{tab.file}</span>
            </a>
            <button type="button" class="buf-close" data-buf-close aria-label={`Close ${tab.file}`}>
              ×
            </button>
          </div>
        ))}
      </div>

      <div class="nvim-winbar">
        <span class="winbar-root">portfolio</span>
        {inSrc && <span class="winbar-sep"> &gt; </span>}
        {inSrc && <span>src</span>}
        <span class="winbar-sep"> &gt; </span>
        <span class="winbar-file">{activeFile}</span>
      </div>

      <div class="nvim-editor">
        <slot />
      </div>
    </div>
  </div>

  <div class="nvim-statusline">
    <div class="sl-a">NORMAL</div>
    <div class="sl-b">
      <span class="branch-icon" aria-hidden="true">
        {'\ue0a0'}
      </span>
      master
    </div>
    <div class="sl-c">
      <span class:list={{ 'file-label': currentPath === '/' }}>
        {activeIcon === 'checkhealth' ? activeFile : activeFile.split('/').pop()}
      </span>
      {currentPath === '/' && <span class="noname-label">[No Name]</span>}
    </div>
    <div class="sl-spacer"></div>
    <div class="sl-x sl-showcmd" id="sl-showcmd" aria-hidden="true"></div>
    <button class="sl-x sl-help" type="button" data-vim-help aria-label="Show key bindings" title="keys (?)">
      ?
    </button>
    <span class="sl-x-div sl-file-info" aria-hidden="true">
      |
    </span>
    <div class="sl-x sl-enc sl-file-info">utf-8</div>
    <span class="sl-x-div sl-file-info" aria-hidden="true">
      |
    </span>
    <div class:list={['sl-x sl-filetype sl-file-info', `ft-${activeIcon}`]}>
      <span class:list={['sl-ft-icon', `icon-${activeIcon}`]}>{devicons[activeIcon]}</span>
      <span>{activeIcon}</span>
    </div>
    <div class="sl-y sl-file-info" id="sl-pct">
      Top
    </div>
    <div class="sl-z" id="sl-pos">
      1:1
    </div>
  </div>

  <div class="nvim-cmdline-row">
    <div class="nvim-cmdline" id="nvim-cmdline" hidden>
      <span class="cmd-prompt" id="nvim-cmdline-prompt" aria-hidden="true">
        :
      </span>
      <input
        id="nvim-cmdline-input"
        class="cmd-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        aria-label="Command line"
      />
      <span class="cmd-msg" id="nvim-cmdline-msg" hidden></span>
      <ul class="cmd-pum" id="nvim-cmd-pum" role="listbox" aria-label="Command completion" hidden></ul>
    </div>
  </div>
</div>

<div id="nvim-help" class="nvim-help" hidden role="dialog" aria-modal="true" aria-label="Key bindings">
  <button class="nvim-help-backdrop" type="button" aria-label="Close key bindings" data-help-close></button>
  <div class="nvim-help-panel">
    <div class="nvim-help-title">:help keys</div>
    <dl>
      <dt>j / k, &darr; / &uarr;</dt>
      <dd>scroll</dd>
      <dt>ctrl+d / ctrl+u</dt>
      <dd>half page down / up</dd>
      <dt>gg / G</dt>
      <dd>top / bottom</dd>
      <dt>]b / [b</dt>
      <dd>next / previous buffer</dd>
      <dt>space e</dt>
      <dd>toggle file tree</dd>
      <dt>space space, space ff, ctrl+k</dt>
      <dd>telescope</dd>
      <dt>space bd</dt>
      <dd>close buffer</dd>
      <dt>:</dt>
      <dd>command line &mdash; tab completes; :q :e file :bn :bp :help :checkhealth :intro</dd>
      <dt>?</dt>
      <dd>this help</dd>
    </dl>
    <div class="nvim-help-sub">cards &amp; lists</div>
    <dl>
      <dt>h j k l</dt>
      <dd>move cursor between cards, enter opens</dd>
      <dt>gg / G</dt>
      <dd>first / last card</dd>
    </dl>
    <div class="nvim-help-sub">projects</div>
    <dl>
      <dt>1 2 3</dt>
      <dd>switch tab</dd>
      <dt>/</dt>
      <dd>filter tiles</dd>
      <dt>[[ / ]]</dt>
      <dd>previous / next project on a project page</dd>
    </dl>
    <div class="nvim-help-hint">everything works with the mouse too. esc closes this.</div>
  </div>
</div>

<style>
  .nvim-shell {
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
    background: var(--color-nvim-bg-hard);
    font-family: var(--font-mono);
  }

  .nvim-titlebar {
    position: relative;
    background: var(--color-nvim-bg-hard);
    padding: 4px 14px;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-nvim-fg2);
    border-bottom: 1px solid var(--color-nvim-bg);
    flex-shrink: 0;
  }
  .nvim-tree-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
    border: 1px solid var(--color-nvim-bg3);
    background: var(--color-nvim-bg1);
    color: var(--color-nvim-fg2);
    padding: 1px 7px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.4;
    cursor: pointer;
  }
  /* Highlight follows the shell's tree state, which is right in the server HTML, so it never flickers on navigation */
  .nvim-tree-trigger:hover,
  .nvim-shell.tree-drawer-open .nvim-tree-trigger {
    color: var(--color-nvim-yellow);
    border-color: var(--color-nvim-yellow);
  }
  @media (min-width: 761px) {
    .nvim-shell:not(.tree-hidden) .nvim-tree-trigger {
      color: var(--color-nvim-yellow);
      border-color: var(--color-nvim-yellow);
    }
  }
  .nvim-tree-trigger:focus-visible {
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: 2px;
  }

  .nvim-bufferline {
    display: flex;
    background: var(--color-nvim-bg);
    border-bottom: 1px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }
  .nvim-bufferline::-webkit-scrollbar {
    display: none;
  }

  .nvim-buffer {
    display: flex;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-nvim-fg2);
    border-right: 1px solid var(--color-nvim-bg-hard);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s;
  }
  .nvim-buffer[hidden] {
    display: none;
  }
  .nvim-buffer:hover {
    color: var(--color-nvim-fg2);
  }
  .nvim-buffer.active {
    background: var(--color-nvim-bg1);
    color: var(--color-nvim-fg);
    border-top: 2px solid var(--color-nvim-yellow);
  }

  .buf-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 6px 5px 14px;
    color: inherit;
    text-decoration: none;
  }
  .nvim-buffer.active .buf-link {
    padding-top: 3px;
  }

  .buf-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-right: 8px;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--color-nvim-fg3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.12s,
      background 0.12s,
      color 0.12s;
  }
  .nvim-buffer:hover .buf-close,
  .nvim-buffer.active .buf-close {
    opacity: 1;
  }
  .buf-close:hover {
    background: var(--color-nvim-bg3);
    color: var(--color-nvim-red, var(--color-nvim-yellow));
  }
  .buf-close:focus-visible {
    opacity: 1;
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: -1px;
  }

  .nvim-main {
    position: relative;
    display: flex;
    flex: 1;
    overflow: hidden;
  }
  .nvimtree-backdrop {
    display: none;
  }

  .nvimtree {
    width: 320px;
    background: var(--color-nvim-bg);
    border-right: 2px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    overflow-y: auto;
    font-size: var(--text-sm);
  }
  .nvimtree::-webkit-scrollbar {
    width: 3px;
  }
  .nvimtree::-webkit-scrollbar-thumb {
    background: var(--color-nvim-bg3);
  }

  .tree-folder {
    display: flex;
    align-items: center;
    gap: 5px;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 2px 10px;
    color: var(--color-nvim-blue);
    font-size: var(--text-sm);
    line-height: 1.8;
    cursor: pointer;
    font-family: var(--font-mono);
    text-align: left;
  }
  .tree-folder:hover {
    background: var(--color-nvim-bg1);
  }
  .tree-folder:not(button) {
    cursor: default;
  }
  .tree-folder:not(button):hover {
    background: transparent;
  }
  .tree-folder:focus-visible {
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: -1px;
  }
  .tree-caret {
    width: 10px;
    flex-shrink: 0;
    color: var(--color-nvim-fg3);
  }
  [data-tree-group][hidden] {
    display: none;
  }
  .tree-file {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    color: var(--color-nvim-fg2);
    font-size: var(--text-sm);
    line-height: 1.8;
    text-decoration: none;
    transition: background 0.1s;
  }
  .tree-file:hover {
    background: var(--color-nvim-bg1);
  }
  .tree-file.tree-active {
    background: var(--color-nvim-bg2);
    color: var(--color-nvim-fg);
  }

  .tree-indent-1 {
    padding-left: 20px;
  }
  .tree-indent-2 {
    padding-left: 32px;
  }
  .tree-indent-3 {
    padding-left: 44px;
  }
  .tree-indent-4 {
    padding-left: 56px;
  }

  .buf-icon,
  .tree-icon {
    font-family: 'JetBrains Mono Nerd Font Icons', var(--font-mono);
    font-size: var(--text-base);
    font-weight: 400;
    width: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .icon-astro {
    color: var(--color-devicon-astro);
  }
  .icon-mdx {
    color: var(--color-devicon-mdx);
  }
  /* package.json is the only JSON buffer; devicons colors it by filename */
  .icon-json {
    color: var(--color-devicon-package-json);
  }
  .icon-checkhealth {
    color: var(--color-devicon-checkhealth);
  }

  /* While the home intro shows, index.astro is a fresh [No Name] buffer, like nvim right after launch */
  .noname-label,
  .noname-text {
    display: none;
  }
  :global(html[data-intro='on']) .noname-text {
    display: inline;
  }
  :global(html[data-intro='on']) .nvim-buffer[data-path='/'] .buf-close,
  :global(html[data-intro='on']) .file-label,
  :global(html[data-intro='on']) .nvim-winbar,
  :global(html[data-intro='on']) .sl-file-info {
    display: none;
  }
  :global(html[data-intro='on']) .nvim-buffer[data-path='/'] .buf-link {
    padding-right: 14px;
  }
  :global(html[data-intro='on']) .noname-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  :global(html[data-intro='on']) .tree-file.tree-active:not(:hover) {
    background: transparent;
    color: var(--color-nvim-fg2);
  }
  .noname-icon {
    width: 22px;
    height: 14px;
    flex-shrink: 0;
    color: var(--color-devicon-default);
  }

  .nvim-editor-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .nvim-winbar {
    background: var(--color-nvim-bg1);
    padding: 3px 14px;
    font-size: var(--text-sm);
    color: var(--color-nvim-fg2);
    border-bottom: 1px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0;
  }
  .winbar-root {
    color: var(--color-nvim-blue);
  }
  .winbar-sep {
    color: var(--color-nvim-fg3);
    margin: 0 6px;
  }
  .winbar-file {
    color: var(--color-nvim-yellow);
  }

  .nvim-editor {
    flex: 1;
    overflow-y: auto;
    background: var(--color-nvim-bg);
    padding: 24px 28px;
    font-family: var(--font-sans);
  }
  .nvim-editor::-webkit-scrollbar {
    width: 4px;
  }
  .nvim-editor::-webkit-scrollbar-thumb {
    background: var(--color-nvim-bg3);
  }

  .nvim-statusline {
    display: flex;
    align-items: stretch;
    font-size: var(--text-sm);
    height: 22px;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--color-nvim-bg2);
    --sl-mode: var(--color-nvim-yellow-dim);
  }
  .nvim-statusline[data-mode='INSERT'] {
    --sl-mode: var(--color-nvim-blue);
  }
  .nvim-statusline[data-mode='VISUAL'] {
    --sl-mode: var(--color-nvim-orange);
  }
  .nvim-statusline[data-mode='COMMAND'] {
    --sl-mode: var(--color-nvim-green);
  }

  /* lualine gruvbox: a/z take the mode color, b/y bg3, c/x bg2 */
  .sl-a,
  .sl-b,
  .sl-c,
  .sl-x,
  .sl-y,
  .sl-z {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding: 0 10px;
  }
  .sl-a,
  .sl-z {
    background: var(--sl-mode);
    color: var(--color-nvim-bg);
    font-weight: 700;
    transition: background 0.12s ease;
  }
  .sl-a {
    padding: 0 12px;
  }
  .sl-b,
  .sl-y {
    background: var(--color-nvim-bg3);
    color: var(--color-nvim-fg);
    gap: 5px;
  }
  .sl-b {
    color: var(--sl-mode);
    transition: color 0.12s ease;
  }
  .branch-icon {
    font-family: 'JetBrains Mono Nerd Font Icons', var(--font-mono);
    font-size: var(--text-base);
    font-weight: 400;
    flex-shrink: 0;
  }
  .sl-c {
    color: var(--color-nvim-fg2);
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-spacer {
    flex: 1;
  }
  .sl-x {
    color: var(--color-nvim-fg2);
  }
  .sl-x-div {
    display: flex;
    align-items: center;
    color: var(--color-nvim-fg3);
    flex-shrink: 0;
  }
  .sl-filetype {
    gap: 6px;
  }
  .sl-ft-icon {
    font-size: var(--text-base);
    font-family: 'JetBrains Mono Nerd Font Icons', var(--font-mono);
    font-weight: 400;
    display: inline-flex;
