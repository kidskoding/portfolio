  }
  .sl-ft-icon.icon-mdx {
    color: var(--color-devicon-mdx);
  }
  .sl-ft-icon.icon-json {
    color: var(--color-devicon-package-json);
  }
  .sl-ft-icon.icon-checkhealth {
    color: var(--color-devicon-checkhealth);
