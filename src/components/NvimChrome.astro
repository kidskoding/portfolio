  .sl-help:hover {
    color: var(--color-nvim-fg);
  }

  /* cmdheight=1: the row always exists under the statusline, empty until the command line or a message fills it.
     The row itself is never [hidden]: Tailwind preflight's layered [hidden] { display: none !important } can't be
     overridden from here, so hiding toggles the inner .nvim-cmdline instead. */
  .nvim-cmdline-row {
    height: 22px;
    flex-shrink: 0;
    background: var(--color-nvim-bg-hard);
  }
  .nvim-cmdline {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 100%;
    padding: 0 10px;
