    padding: 0;
    list-style: none;
    background: var(--color-nvim-bg2);
    color: var(--color-nvim-fg);
  }
  .cmd-pum[hidden] {
    display: none;
  }
  .cmd-pum li {
    padding: 0 1ch;
    line-height: 22px;
    white-space: nowrap;
    cursor: pointer;
  }
  .cmd-pum li:hover,
  .cmd-pum li[aria-selected='true'] {
    background: var(--color-nvim-blue);
    color: var(--color-nvim-bg2);
    font-weight: 700;
