---
import { getCollection } from 'astro:content';

interface Props {
  currentPath: string;
}

const { currentPath: rawPath } = Astro.props;
const currentPath = rawPath === '/' ? '/' : rawPath.replace(/\/$/, '');

const buffers = [
  { path: '/', file: 'index.astro', icon: 'astro', pinned: true },
  { path: '/about', file: 'about.astro', icon: 'astro' },
  { path: '/experience', file: 'experience.astro', icon: 'astro', pinned: true },
  { path: '/projects', file: 'projects.astro', icon: 'astro' },
  { path: '/skills', file: 'skills.astro', icon: 'astro' },
  { path: '/certificates', file: 'certificates.astro', icon: 'astro' },
  { path: '/blog', file: 'blog.astro', icon: 'astro' },
  { path: '/contact', file: 'contact.astro', icon: 'astro' },
];
const treeFiles = buffers;
type TabIcon = 'astro' | 'mdx' | 'json';
interface Tab { path: string; file: string; icon: TabIcon; pinned?: boolean }

let activeFile = 'index.astro';
let activeIcon: 'astro' | 'mdx' | 'json' = 'astro';
const blogSlug = currentPath.match(/^\/blog\/(.+)$/);
const projectSlug = currentPath.match(/^\/projects\/(.+)$/);
if (blogSlug) {
  activeFile = `blog/${blogSlug[1]}.mdx`;
  activeIcon = 'mdx';
} else if (projectSlug) {
  activeFile = `projects/${projectSlug[1]}.mdx`;
  activeIcon = 'mdx';
} else if (currentPath === '/package-json') {
  activeFile = 'package.json';
  activeIcon = 'json';
} else {
  const match = buffers.find((b) => b.path === currentPath);
  if (match) {
    activeFile = match.file;
    activeIcon = match.icon as 'astro' | 'mdx' | 'json';
  }
}

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.id.localeCompare(b.id)
);

const tabs: Tab[] = [
  ...(buffers as Tab[]),
  { path: '/package-json', file: 'package.json', icon: 'json' },
  ...posts.map((post): Tab => ({ path: `/blog/${post.id}`, file: `${post.id}.mdx`, icon: 'mdx' })),
  ...projects.map((project): Tab => ({ path: `/projects/${project.id}`, file: `${project.id}.mdx`, icon: 'mdx' })),
];

const pinIcon = `
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M9.5 1.5 14.5 6.5l-1.4 1.4-.7-.7L9.6 10l.4 3-1.4 1.4L5.5 11.3 2 14.8l-.8-.8 3.5-3.5L1.6 7.4 3 6l3 .4 2.8-2.8-.7-.7z"/>
  </svg>
`;

const astroIcon = `
  <svg viewBox="0 0 85 107" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M27.59 91.14c-4.83-4.42-6.25-13.7-4.23-20.43 3.49 4.25 8.33 5.6 13.35 6.36 7.74 1.18 15.34.74 22.53-2.78.82-.4 1.58-.93 2.48-1.47.67 1.96.85 3.94.61 5.96-.57 4.9-3.02 8.69-6.91 11.58-1.56 1.15-3.2 2.18-4.81 3.27-4.93 3.34-6.27 7.26-4.41 12.92.04.14.08.28.18.62-2.52-1.13-4.36-2.78-5.76-4.95-1.48-2.29-2.18-4.83-2.22-7.55-.02-1.33-.02-2.66-.2-3.97-.44-3.19-1.95-4.61-4.79-4.69-2.91-.08-5.21 1.75-5.82 5.15Z"/>
    <path fill="currentColor" d="M0 69.67s14.33-6.97 28.71-6.97L39.55 29.23c.41-1.63 1.6-2.73 2.94-2.73 1.35 0 2.54 1.1 2.95 2.73L56.27 62.7c17.03 0 28.71 6.97 28.71 6.97S60.64 3.39 60.59 3.25C59.89 1.3 58.71 0 57.11 0H27.88c-1.6 0-2.74 1.3-3.49 3.25C24.34 3.39 0 69.67 0 69.67Z"/>
  </svg>
`;
---

<div class="nvim-shell">
  <div class="nvim-titlebar">
    <button
      class="nvim-tree-trigger"
      type="button"
      aria-controls="nvimtree"
      aria-expanded="false"
      aria-label="Open file explorer"
      data-tree-drawer-toggle
    >
      <span aria-hidden="true">☰</span>
      <span>NvimTree</span>
    </button>
    <span>nvim - portfolio/src/{activeFile}</span>
  </div>

  <div class="nvim-main">
    <button class="nvimtree-backdrop" type="button" aria-label="Close file explorer" data-tree-drawer-close></button>
    <nav class="nvimtree" id="nvimtree" aria-label="File explorer">
      <div class="nvimtree-body">
        <div class="tree-folder">
          <span class="tree-caret" aria-hidden="true">v</span>
          <span>portfolio</span>
        </div>
        <a
          href='/package-json'
          class:list={['tree-file tree-indent-1', { 'tree-active': currentPath === '/package-json' }]}
        >
          <span class="tree-icon icon-json">JSON</span>
          <span>package.json</span>
        </a>
        <div class="tree-folder tree-indent-1">
          <span class="tree-caret" aria-hidden="true">v</span>
          <span>src</span>
        </div>
        <div>
            {treeFiles.map((buf) => (
              <a
                href={buf.path}
                class:list={['tree-file tree-indent-2', { 'tree-active': currentPath === buf.path }]}
              >
                <span class:list={['tree-icon', buf.icon === 'mdx' ? 'icon-mdx' : 'icon-astro']}>
                  {buf.icon === 'astro' ? <Fragment set:html={astroIcon} /> : 'MDX'}
                </span>
                <span>{buf.file}</span>
              </a>
            ))}
            <button class="tree-folder tree-indent-2" type="button" data-tree-toggle="blog-posts" aria-expanded="true">
              <span class="tree-caret" aria-hidden="true">v</span>
              <span>blog-posts</span>
            </button>
            <div data-tree-group="blog-posts">
              {posts.map((post) => (
                <a
                  href={`/blog/${post.id}`}
                  class:list={['tree-file tree-indent-3', { 'tree-active': currentPath === `/blog/${post.id}` }]}
                >
                  <span class="tree-icon icon-mdx">MDX</span>
                  <span>{post.id}.mdx</span>
                </a>
              ))}
            </div>
            <button class="tree-folder tree-indent-2" type="button" data-tree-toggle="projects" aria-expanded="false">
              <span class="tree-caret" aria-hidden="true">&gt;</span>
              <span>projects</span>
            </button>
            <div data-tree-group="projects" hidden>
              {projects.map((project) => (
                <a
                  href={`/projects/${project.id}`}
                  class:list={['tree-file tree-indent-3', { 'tree-active': currentPath === `/projects/${project.id}` }]}
                >
                  <span class="tree-icon icon-mdx">MDX</span>
                  <span>{project.id}.mdx</span>
                </a>
              ))}
            </div>
            <div class="tree-folder tree-indent-2">&gt; <span>data</span></div>
            <div class="tree-folder tree-indent-2">&gt; <span>components</span></div>
            <div class="tree-folder tree-indent-2">&gt; <span>layouts</span></div>
          </div>
          <div class="tree-folder tree-indent-1">&gt; <span>public</span></div>
          <div class="tree-folder tree-indent-1">&gt; <span>node_modules</span></div>
      </div>
    </nav>

    <div class="nvim-editor-wrap">
      <div class="nvim-bufferline">
        {tabs.map((tab) => (
          <div
            class:list={['nvim-buffer', { active: currentPath === tab.path, pinned: tab.pinned }]}
            data-path={tab.path}
            data-pinned={tab.pinned ? 'true' : undefined}
            hidden={!tab.pinned && currentPath !== tab.path}
          >
            <a href={tab.path} class="buf-link">
              {tab.pinned && <span class="buf-pin" set:html={pinIcon} />}
              <span class:list={['buf-icon', `icon-${tab.icon}`]}>
                {tab.icon === 'astro' ? <Fragment set:html={astroIcon} /> : tab.icon.toUpperCase()}
              </span>
              <span>{tab.file}</span>
            </a>
            {!tab.pinned && (
              <button type="button" class="buf-close" data-buf-close aria-label={`Close ${tab.file}`}>×</button>
            )}
          </div>
        ))}
      </div>

      <div class="nvim-winbar">
        <span class="winbar-root">portfolio</span>
        {activeIcon !== 'json' && <span class="winbar-sep"> &gt; </span>}
        {activeIcon !== 'json' && <span>src</span>}
        <span class="winbar-sep"> &gt; </span>
        <span class="winbar-file">{activeFile}</span>
      </div>

      <div class="nvim-editor">
        <slot />
      </div>
    </div>
  </div>

  <div class="nvim-statusline">
    <div class="sl-a"> NORMAL</div>
    <div class="sl-b">
      <svg class="branch-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0zm0 2.122a2.25 2.25 0 1 0-1.5 0v.878A2.25 2.25 0 0 0 5.75 8.5h1.5v2.128a2.251 2.251 0 1 0 1.5 0V8.5h1.5a2.25 2.25 0 0 0 2.25-2.25v-.878a2.25 2.25 0 1 0-1.5 0v.878a.75.75 0 0 1-.75.75h-4.5A.75.75 0 0 1 5 6.25v-.878zm3.75 7.378a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0zm3-8.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0z"/>
      </svg>
      main
    </div>
    <div class="sl-c">~/portfolio/src/{activeFile}</div>
    <div class="sl-spacer"></div>
    <div class="sl-x sl-showcmd" id="sl-showcmd" aria-hidden="true"></div>
    <button class="sl-x sl-help" type="button" data-vim-help aria-label="Show key bindings" title="keys (?)">?</button>
    <div class="sl-x-div"></div>
    <div class="sl-x sl-enc"> utf-8</div>
    <div class="sl-x-div"></div>
    <div class:list={['sl-x sl-filetype', `ft-${activeIcon}`]}>
      {activeIcon === 'mdx' && <span class="sl-ft-icon icon-mdx">MDX</span>}
      {activeIcon === 'json' && <span class="sl-ft-icon icon-json">JSON</span>}
      {activeIcon === 'astro' && <span class="sl-ft-icon icon-astro" set:html={astroIcon}></span>}
      <span>{activeIcon === 'mdx' ? 'MDX' : activeIcon === 'json' ? 'JSON' : 'Astro'}</span>
    </div>
    <div class="sl-x-div"></div>
    <div class="sl-x sl-pct" id="sl-pct"> Top</div>
    <div class="sl-x-div"></div>
    <div class="sl-y" id="sl-pos"> 1:1</div>
  </div>

  <div class="nvim-cmdline" id="nvim-cmdline" hidden>
    <span class="cmd-prompt" id="nvim-cmdline-prompt" aria-hidden="true">:</span>
    <input id="nvim-cmdline-input" class="cmd-input" type="text" autocomplete="off" spellcheck="false" aria-label="Command line" />
    <span class="cmd-msg" id="nvim-cmdline-msg" hidden></span>
  </div>
</div>

<div id="nvim-help" class="nvim-help" hidden role="dialog" aria-modal="true" aria-label="Key bindings">
  <button class="nvim-help-backdrop" type="button" aria-label="Close key bindings" data-help-close></button>
  <div class="nvim-help-panel">
    <div class="nvim-help-title">:help keys</div>
    <dl>
      <dt>j / k, &darr; / &uarr;</dt><dd>scroll</dd>
      <dt>ctrl+d / ctrl+u</dt><dd>half page down / up</dd>
      <dt>gg / G</dt><dd>top / bottom</dd>
      <dt>]b / [b</dt><dd>next / previous buffer</dd>
      <dt>space e</dt><dd>toggle file tree</dd>
      <dt>space ff, ctrl+k</dt><dd>telescope</dd>
      <dt>space bd</dt><dd>close buffer</dd>
      <dt>:</dt><dd>command line &mdash; :q :e file :bn :bp :help</dd>
      <dt>?</dt><dd>this help</dd>
    </dl>
    <div class="nvim-help-sub">cards &amp; lists</div>
    <dl>
      <dt>h j k l</dt><dd>move cursor between cards, enter opens</dd>
      <dt>gg / G</dt><dd>first / last card</dd>
    </dl>
    <div class="nvim-help-sub">projects</div>
    <dl>
      <dt>1 2 3</dt><dd>switch tab</dd>
      <dt>/</dt><dd>filter tiles</dd>
      <dt>[[ / ]]</dt><dd>previous / next project on a project page</dd>
    </dl>
    <div class="nvim-help-hint">everything works with the mouse too. esc closes this.</div>
  </div>
</div>

<style>
  .nvim-shell {
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
    background: var(--color-nvim-bg-hard);
    font-family: var(--font-mono);
  }

  .nvim-titlebar {
    position: relative;
    background: var(--color-nvim-bg-hard);
    padding: 4px 14px;
    text-align: center;
    font-size: 11px;
    color: var(--color-nvim-fg3);
    border-bottom: 1px solid var(--color-nvim-bg);
    flex-shrink: 0;
  }
  .nvim-tree-trigger {
    display: none;
    align-items: center;
    gap: 6px;
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
    border: 1px solid var(--color-nvim-bg3);
    background: var(--color-nvim-bg1);
    color: var(--color-nvim-fg2);
    padding: 1px 7px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    cursor: pointer;
  }
  .nvim-tree-trigger:hover,
  .nvim-tree-trigger[aria-expanded='true'] {
    color: var(--color-nvim-yellow);
    border-color: var(--color-nvim-yellow);
  }
  .nvim-tree-trigger:focus-visible {
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: 2px;
  }

  .nvim-bufferline {
    display: flex;
    background: var(--color-nvim-bg);
    border-bottom: 1px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }
  .nvim-bufferline::-webkit-scrollbar { display: none; }

  .nvim-buffer {
    display: flex;
    align-items: center;
    font-size: 12px;
    color: var(--color-nvim-fg3);
    border-right: 1px solid var(--color-nvim-bg-hard);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s;
  }
  .nvim-buffer[hidden] { display: none; }
  .nvim-buffer:hover { color: var(--color-nvim-fg2); }
  .nvim-buffer.active {
    background: var(--color-nvim-bg1);
    color: var(--color-nvim-fg);
    border-top: 2px solid var(--color-nvim-yellow);
  }

  .buf-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 6px 5px 14px;
    color: inherit;
    text-decoration: none;
  }
  .nvim-buffer.active .buf-link { padding-top: 3px; }

  .buf-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-right: 8px;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--color-nvim-fg3);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.12s, background 0.12s, color 0.12s;
  }
  .nvim-buffer:hover .buf-close,
  .nvim-buffer.active .buf-close { opacity: 1; }
  .buf-close:hover {
    background: var(--color-nvim-bg3);
    color: var(--color-nvim-red, var(--color-nvim-yellow));
  }
  .buf-close:focus-visible {
    opacity: 1;
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: -1px;
  }

  .buf-pin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    flex-shrink: 0;
    color: var(--color-nvim-fg3);
  }
  .buf-pin :global(svg) { width: 13px; height: 13px; display: block; }
  .nvim-buffer.active .buf-pin { color: var(--color-nvim-yellow); }
  .nvim-buffer.pinned .buf-link { padding-right: 20px; }

  .nvim-main {
    position: relative;
    display: flex;
    flex: 1;
    overflow: hidden;
  }
  .nvimtree-backdrop {
    display: none;
  }

  .nvimtree {
    width: 210px;
    background: var(--color-nvim-bg);
    border-right: 2px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    overflow-y: auto;
    font-size: 12px;
  }
  .nvimtree::-webkit-scrollbar { width: 3px; }
  .nvimtree::-webkit-scrollbar-thumb { background: var(--color-nvim-bg3); }


  .tree-folder {
    display: flex;
    align-items: center;
    gap: 5px;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 2px 10px;
    color: var(--color-nvim-blue);
    font-size: 12px;
    line-height: 1.8;
    cursor: pointer;
    font-family: var(--font-mono);
    text-align: left;
  }
  .tree-folder:hover {
    background: var(--color-nvim-bg1);
  }
  .tree-folder:not(button) {
    cursor: default;
  }
  .tree-folder:not(button):hover {
    background: transparent;
  }
  .tree-folder:focus-visible {
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: -1px;
  }
  .tree-caret {
    width: 10px;
    flex-shrink: 0;
    color: var(--color-nvim-fg3);
  }
  [data-tree-group][hidden] {
    display: none;
  }
  .tree-file {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    color: var(--color-nvim-fg2);
    font-size: 12px;
    line-height: 1.8;
    text-decoration: none;
    transition: background 0.1s;
  }
  .tree-file:hover { background: var(--color-nvim-bg1); }
  .tree-file.tree-active {
    background: var(--color-nvim-bg2);
    color: var(--color-nvim-fg);
  }

  .tree-indent-1 { padding-left: 20px; }
  .tree-indent-2 { padding-left: 32px; }
  .tree-indent-3 { padding-left: 44px; }
  .tree-indent-4 { padding-left: 56px; }

  .buf-icon,
  .tree-icon {
    font-size: 9px;
    font-weight: 700;
    width: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .icon-astro {
    color: var(--color-nvim-orange);
  }
  .icon-astro :global(svg) {
    width: 13px;
    height: 13px;
    display: block;
  }
  .icon-mdx { color: var(--color-nvim-purple); }

  .nvim-editor-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .nvim-winbar {
    background: var(--color-nvim-bg1);
    padding: 3px 14px;
    font-size: 12px;
    color: var(--color-nvim-fg3);
    border-bottom: 1px solid var(--color-nvim-bg-hard);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0;
  }
  .winbar-root { color: var(--color-nvim-blue); }
  .winbar-sep { color: var(--color-nvim-bg3); margin: 0 6px; }
  .winbar-file { color: var(--color-nvim-yellow); }

  .nvim-editor {
    flex: 1;
    overflow-y: auto;
    background: var(--color-nvim-bg);
    padding: 24px 28px;
    font-family: var(--font-sans);
  }
  .nvim-editor::-webkit-scrollbar { width: 4px; }
  .nvim-editor::-webkit-scrollbar-thumb { background: var(--color-nvim-bg3); }

  .nvim-statusline {
    display: flex;
    align-items: stretch;
    font-size: 12px;
    height: 22px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .sl-a,
  .sl-b,
  .sl-c,
  .sl-x,
  .sl-y {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .sl-a {
    background: var(--sl-mode, var(--color-nvim-yellow));
    color: var(--color-nvim-bg-hard);
    padding: 0 12px;
    font-weight: 700;
    transition: background 0.12s ease;
  }
  .nvim-statusline[data-mode='INSERT'] { --sl-mode: var(--color-nvim-blue); }
  .nvim-statusline[data-mode='VISUAL'] { --sl-mode: var(--color-nvim-orange); }
  .nvim-statusline[data-mode='COMMAND'] { --sl-mode: var(--color-nvim-green); }
  .sl-b {
    background: var(--color-nvim-bg3);
    color: var(--color-nvim-green);
    padding: 0 10px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .branch-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }
  .sl-c {
    background: var(--color-nvim-bg1);
    color: var(--color-nvim-fg2);
    padding: 0 10px;
    font-size: 11px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-spacer { flex: 1; background: var(--color-nvim-bg1); }
  .sl-filetype { gap: 5px; }
  .sl-ft-icon {
    font-size: 9px;
    font-weight: 700;
    width: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sl-ft-icon.icon-astro { color: var(--color-nvim-orange); }
  :global(.sl-ft-icon.icon-astro svg) { width: 11px; height: 11px; display: block; }
  .sl-ft-icon.icon-mdx { color: var(--color-nvim-purple); }
  .sl-ft-icon.icon-json { color: var(--color-nvim-yellow); width: auto; }
  .sl-ft-icon.icon-mdx { width: auto; }
  .icon-json { color: var(--color-nvim-yellow); }
  .sl-x-div {
    width: 1px;
    background: var(--color-nvim-bg);
    flex-shrink: 0;
  }
  .sl-x {
    background: var(--color-nvim-bg3);
    color: var(--color-nvim-fg);
    padding: 0 10px;
  }
  .sl-enc { background: var(--color-nvim-purple); color: var(--color-nvim-bg-hard); font-weight: 600; }
  .sl-pct { background: var(--color-nvim-blue); color: var(--color-nvim-bg-hard); font-weight: 600; }
  .sl-filetype { color: var(--color-nvim-bg-hard); font-weight: 600; }
  .sl-filetype.ft-astro { background: var(--color-nvim-orange); }
  .sl-filetype.ft-mdx { background: var(--color-nvim-red); }
  .sl-filetype.ft-json { background: var(--color-nvim-yellow); }
  .sl-filetype .sl-ft-icon,
  .sl-filetype .sl-ft-icon.icon-astro,
  .sl-filetype .sl-ft-icon.icon-mdx,
  .sl-filetype .sl-ft-icon.icon-json { color: var(--color-nvim-bg-hard); }
  .sl-y {
    background: var(--color-nvim-green);
    color: var(--color-nvim-bg-hard);
    padding: 0 10px;
    font-weight: 700;
  }

  .sl-showcmd {
    color: var(--color-nvim-fg2);
    padding: 0 8px;
    min-width: 0;
  }
  .sl-showcmd:empty { display: none; }
  .sl-help {
    background: var(--color-nvim-gray);
    border: 0;
    padding: 0 10px;
    color: var(--color-nvim-bg-hard);
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }
  .sl-help:hover { background: var(--color-nvim-fg2); }

  .nvim-cmdline {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 22px;
    padding: 0 10px;
    flex-shrink: 0;
    background: var(--color-nvim-bg-hard);
    font-size: 12px;
    color: var(--color-nvim-fg);
  }
  .nvim-cmdline[hidden] { display: none; }
  .cmd-prompt { color: var(--color-nvim-fg); }
  .cmd-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: 0;
    padding: 0;
    color: var(--color-nvim-fg);
    font: inherit;
    caret-color: var(--color-nvim-yellow);
  }
  .cmd-msg { color: var(--color-nvim-fg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cmd-msg.error { color: var(--color-nvim-red); }

  .nvim-help {
    position: fixed;
    inset: 0;
    z-index: 9100;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
  }
  .nvim-help[hidden] { display: none; }
  .nvim-help-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(10, 8, 5, 0.75);
    cursor: default;
  }
  .nvim-help-panel {
    position: relative;
    width: 460px;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    background: var(--color-nvim-bg1);
    border: 1px solid var(--color-nvim-bg3);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
    padding: 14px 18px;
    font-size: 12px;
  }
  .nvim-help-title { color: var(--color-nvim-green); font-weight: 700; margin-bottom: 8px; }
  .nvim-help-sub { color: var(--color-nvim-fg3); margin: 10px 0 4px; }
  .nvim-help dl { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 3px 14px; margin: 0; }
  .nvim-help dt { color: var(--color-nvim-yellow); }
  .nvim-help dd { color: var(--color-nvim-fg2); margin: 0; }
  .nvim-help-hint { color: var(--color-nvim-fg3); margin-top: 12px; }

  @media (min-width: 761px) {
    .nvim-shell.tree-hidden .nvimtree { display: none; }
  }

  @media (max-width: 760px) {
    .nvim-titlebar {
      padding-left: 100px;
      padding-right: 10px;
      text-align: left;
    }

    .nvim-titlebar > span {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .nvim-tree-trigger {
      display: inline-flex;
    }

    .nvim-bufferline {
      min-height: 31px;
    }

    .nvim-buffer {
      padding-left: 10px;
      padding-right: 10px;
      max-width: 140px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .nvim-buffer.pinned .buf-link > span:last-child { display: none; }
    .nvim-buffer.pinned .buf-link { padding-right: 6px; }

    .nvimtree {
      position: absolute;
      inset: 0 auto 0 0;
      z-index: 20;
      width: min(82vw, 300px);
      border-right: 2px solid var(--color-nvim-yellow);
      box-shadow: 18px 0 40px rgba(0, 0, 0, 0.55);
      transform: translateX(-100%);
      transition: transform 0.18s ease;
    }

    .nvim-shell.tree-drawer-open .nvimtree {
      transform: translateX(0);
    }

    .nvimtree-backdrop {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 10;
      border: 0;
      background: rgba(10, 8, 5, 0.58);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.18s ease;
    }

    .nvim-shell.tree-drawer-open .nvimtree-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .nvim-editor {
      padding: 14px;
    }

    :global(.nvim-editor main) {
      padding-left: 0;
      padding-right: 0;
    }

    .sl-c {
      display: none;
    }

    .sl-b,
    .sl-x,
    .sl-x-div {
      display: none;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  function initNvimTreeDrawer() {
    const shell = document.querySelector<HTMLElement>('.nvim-shell');
    const trigger = document.querySelector<HTMLButtonElement>('[data-tree-drawer-toggle]');
    const closeButton = document.querySelector<HTMLButtonElement>('[data-tree-drawer-close]');
    const tree = document.getElementById('nvimtree');
    if (!shell || !trigger || !closeButton || !tree) return;
    if (trigger.dataset.bound === 'true') return;
    trigger.dataset.bound = 'true';

    function setOpen(isOpen: boolean) {
      shell.classList.toggle('tree-drawer-open', isOpen);
      trigger.setAttribute('aria-expanded', String(isOpen));
      trigger.setAttribute('aria-label', isOpen ? 'Close file explorer' : 'Open file explorer');
    }

    trigger.addEventListener('click', () => {
      setOpen(!shell.classList.contains('tree-drawer-open'));
    });

    closeButton.addEventListener('click', () => setOpen(false));

    tree.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && shell.classList.contains('tree-drawer-open')) {
        setOpen(false);
      }
    });
  }

  function applyTreeState(toggle: HTMLButtonElement, expanded: boolean) {
    const key = toggle.dataset.treeToggle;
    if (!key) return;
    const group = document.querySelector<HTMLElement>(`[data-tree-group="${key}"]`);
    if (!group) return;
    toggle.setAttribute('aria-expanded', String(expanded));
    group.hidden = !expanded;
    const caret = toggle.querySelector<HTMLElement>('.tree-caret');
    if (caret) caret.textContent = expanded ? 'v' : '>';
  }

  function initNvimTree() {
    document.querySelectorAll<HTMLButtonElement>('[data-tree-toggle]').forEach((toggle) => {
      const key = toggle.dataset.treeToggle;
      if (!key) return;

      const stored = sessionStorage.getItem(`tree:${key}`);
      const expanded = stored === null ? toggle.getAttribute('aria-expanded') !== 'false' : stored === 'true';
      applyTreeState(toggle, expanded);

      if (toggle.dataset.bound === 'true') return;
      toggle.dataset.bound = 'true';

      toggle.addEventListener('click', () => {
        const isExpanded = toggle.getAttribute('aria-expanded') !== 'false';
        applyTreeState(toggle, !isExpanded);
        sessionStorage.setItem(`tree:${key}`, String(!isExpanded));
      });
    });
  }

  function initStatusline() {
    const editor = document.querySelector<HTMLElement>('.nvim-editor');
    const pctEl = document.getElementById('sl-pct');
    const posEl = document.getElementById('sl-pos');
    if (!editor || !pctEl || !posEl) return;

    function update() {
      const scrollTop = editor.scrollTop;
      const scrollHeight = editor.scrollHeight - editor.clientHeight;
      const line = Math.max(1, Math.round(scrollTop / 20) + 1);
      posEl.textContent = `${line}:1`;
      if (scrollHeight <= 0 || scrollTop === 0) {
        pctEl.textContent = ' Top';
      } else if (scrollTop >= scrollHeight - 1) {
        pctEl.textContent = ' Bot';
      } else {
        pctEl.textContent = ` ${Math.round((scrollTop / scrollHeight) * 100)}%`;
      }
    }

    editor.removeEventListener('scroll', update);
    editor.addEventListener('scroll', update, { passive: true });
    update();
  }

  const OPENED_KEY = 'nvim:opened-buffers';

  function getOpened(): string[] {
    try {
      return JSON.parse(sessionStorage.getItem(OPENED_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function setOpened(paths: string[]) {
    sessionStorage.setItem(OPENED_KEY, JSON.stringify(paths));
  }

  function initBuffers() {
    const bufferline = document.querySelector<HTMLElement>('.nvim-bufferline');
    if (!bufferline) return;

    const isPinned = (tab: HTMLElement) => tab.dataset.pinned === 'true';

    // Visiting a page opens its buffer (like editing a file in vim).
    const current = bufferline.querySelector<HTMLElement>('.nvim-buffer.active');
    const currentPath = current?.dataset.path;
    let opened = getOpened();
    if (currentPath && current && !isPinned(current) && !opened.includes(currentPath)) {
      opened.push(currentPath);
      setOpened(opened);
    }

    opened.forEach((path) => {
      const tab = bufferline.querySelector<HTMLElement>(`.nvim-buffer[data-path="${CSS.escape(path)}"]`);
      if (tab && !isPinned(tab)) bufferline.appendChild(tab);
    });

    bufferline.querySelectorAll<HTMLElement>('.nvim-buffer').forEach((tab) => {
      const path = tab.dataset.path;
      tab.hidden = !isPinned(tab) && !(path && opened.includes(path)) && !tab.classList.contains('active');
    });

    current?.scrollIntoView({ block: 'nearest', inline: 'nearest' });

    if (bufferline.dataset.bound === 'true') return;
    bufferline.dataset.bound = 'true';

    bufferline.addEventListener(
      'wheel',
      (e) => {
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
        if (bufferline.scrollWidth <= bufferline.clientWidth) return;
        e.preventDefault();
        bufferline.scrollLeft += e.deltaY;
      },
      { passive: false }
    );

    bufferline.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-buf-close]');
      if (!btn) return;
      e.preventDefault();
      const tab = btn.closest<HTMLElement>('.nvim-buffer');
      const path = tab?.dataset.path;
      if (!tab || !path || isPinned(tab)) return;

      setOpened(getOpened().filter((p) => p !== path));

      const wasActive = tab.classList.contains('active');
      const all = [...bufferline.querySelectorAll<HTMLElement>('.nvim-buffer')];
      const idx = all.indexOf(tab);
      tab.hidden = true;

      if (wasActive) {
        const neighbor =
          all.slice(idx + 1).find((t) => !t.hidden) ||
          all.slice(0, idx).reverse().find((t) => !t.hidden);
        const target = neighbor?.querySelector<HTMLAnchorElement>('.buf-link');
        navigate(target ? target.href : '/');
      }
    });
  }

  // A hard reload / fresh document load starts with a clean bufferline (only the
  // current tab). Soft navigations (clicking a link) run via astro:page-load and
  // keep accumulating tabs. This top-level code runs once per real document load.
  const navType = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  if (navType?.type === 'reload') {
    sessionStorage.removeItem(OPENED_KEY);
  }

  const TREE_HIDDEN_KEY = 'nvim:tree-hidden';
  const PENDING_TIMEOUT = 900;
  const MESSAGE_TIMEOUT = 4000;
  const LINE_STEP = 60;

  function applyTreeHidden() {
    const shell = document.querySelector<HTMLElement>('.nvim-shell');
    if (shell) shell.classList.toggle('tree-hidden', sessionStorage.getItem(TREE_HIDDEN_KEY) === 'true');
  }

  // Site-wide vim layer: scroll keys, buffer switching, command line, help.
  // Bound once per document; elements are looked up lazily because the chrome
  // is re-rendered on every view transition.
  function initVim() {
    if (document.documentElement.dataset.vimBound === 'true') return;
    document.documentElement.dataset.vimBound = 'true';

    const q = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);
    const editor = () => q('.nvim-editor');
    const cmdline = () => q('#nvim-cmdline');
    const cmdInput = () => q<HTMLInputElement>('#nvim-cmdline-input');
    const cmdPrompt = () => q('#nvim-cmdline-prompt');
    const cmdMsg = () => q('#nvim-cmdline-msg');
    const help = () => q('#nvim-help');
    const telescopeOpen = () => document.getElementById('telescope')?.classList.contains('open') ?? false;
    const cmdOpen = () => { const c = cmdline(); return !!c && !c.hidden; };
    const isTyping = (el: Element | null) =>
      !!el && (el.matches('input, textarea, select') || (el as HTMLElement).isContentEditable);

    let pending = '';
    let pendingTimer: number | undefined;
    let msgTimer: number | undefined;

    function setMode(mode: 'NORMAL' | 'INSERT' | 'VISUAL' | 'COMMAND') {
      const el = q('.sl-a');
      if (el) el.textContent = ` ${mode}`;
      const bar = q('.nvim-statusline');
      if (bar) bar.dataset.mode = mode;
    }
    function refreshMode() {
      const input = cmdInput();
      if (cmdOpen() && input && !input.hidden) return setMode('COMMAND');
      if (isTyping(document.activeElement)) return setMode('INSERT');
      const sel = window.getSelection();
      if (sel && !sel.isCollapsed && sel.toString().trim()) return setMode('VISUAL');
      setMode('NORMAL');
    }
    function setPending(keys: string) {
      pending = keys;
      const sc = q('#sl-showcmd');
      if (sc) sc.textContent = keys.replace(/ /g, '\u2423');
      window.clearTimeout(pendingTimer);
      if (keys) pendingTimer = window.setTimeout(() => setPending(''), PENDING_TIMEOUT);
    }

    const scrollBy = (top: number) => editor()?.scrollBy({ top, behavior: 'auto' });
    const scrollTo = (top: number) => editor()?.scrollTo({ top, behavior: 'auto' });

    const visibleTabs = () => [...document.querySelectorAll<HTMLElement>('.nvim-buffer:not([hidden])')];
    function switchBuffer(dir: 1 | -1) {
      const tabs = visibleTabs();
      if (tabs.length < 2) return;
      const i = tabs.findIndex((tab) => tab.classList.contains('active'));
      const link = tabs[(i + dir + tabs.length) % tabs.length].querySelector<HTMLAnchorElement>('.buf-link');
      if (link) navigate(link.getAttribute('href') || '/');
    }
    function closeBuffer() {
      const tab = q('.nvim-buffer.active');
      if (!tab) return;
      if (tab.dataset.pinned === 'true') {
        const file = tab.querySelector('.buf-link span:last-child')?.textContent || 'buffer';
        showMessage(`E37: ${file} is pinned, cannot close`, true);
        return;
      }
      tab.querySelector<HTMLButtonElement>('[data-buf-close]')?.click();
    }
    function toggleTree() {
      const drawerToggle = q<HTMLButtonElement>('[data-tree-drawer-toggle]');
      if (drawerToggle && drawerToggle.offsetParent !== null) {
        drawerToggle.click();
        return;
      }
      const shell = q('.nvim-shell');
      if (!shell) return;
      const hidden = !shell.classList.contains('tree-hidden');
      shell.classList.toggle('tree-hidden', hidden);
      sessionStorage.setItem(TREE_HIDDEN_KEY, String(hidden));
    }
    function openTelescope() {
      if (telescopeOpen()) return;
      document.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', ctrlKey: true, bubbles: true, cancelable: true }));
    }
    function toggleHelp(force?: boolean) {
      const h = help();
      if (!h) return;
      h.hidden = force === undefined ? !h.hidden : !force;
    }

    function showMessage(text: string, error = false) {
      const c = cmdline(), input = cmdInput(), m = cmdMsg(), prompt = cmdPrompt();
      if (!c || !input || !m) return;
      c.hidden = false;
      input.hidden = true;
      if (prompt) prompt.hidden = true;
      if (document.activeElement === input) input.blur();
      m.textContent = text;
      m.classList.toggle('error', error);
      m.hidden = false;
      window.clearTimeout(msgTimer);
      msgTimer = window.setTimeout(hideCmdline, MESSAGE_TIMEOUT);
      refreshMode();
    }
    function openCmdline() {
      const c = cmdline(), input = cmdInput(), m = cmdMsg(), prompt = cmdPrompt();
      if (!c || !input || !m) return;
      window.clearTimeout(msgTimer);
      c.hidden = false;
      m.hidden = true;
      m.textContent = '';
      if (prompt) prompt.hidden = false;
      input.hidden = false;
      input.value = '';
      input.focus();
      setMode('COMMAND');
    }
    function hideCmdline() {
      const c = cmdline(), input = cmdInput();
      window.clearTimeout(msgTimer);
      if (!c) return;
      c.hidden = true;
      if (input && document.activeElement === input) input.blur();
      refreshMode();
    }

    function fuzzyOpen(query: string) {
      const needle = query.trim().toLowerCase();
      if (!needle) {
        showMessage('E471: Argument required', true);
        return;
      }
      const scored = [...document.querySelectorAll<HTMLElement>('.nvim-buffer[data-path]')]
        .map((tab) => {
          const file = (tab.querySelector('.buf-link span:last-child')?.textContent || '').toLowerCase();
          const path = (tab.dataset.path || '').toLowerCase();
          const stem = file.replace(/\.[a-z]+$/, '');
          let score = 0;
          if (stem === needle) score = 5;
          else if (file.startsWith(needle)) score = 4;
          else if (path.startsWith(`/${needle}`)) score = 3;
          else if (file.includes(needle) || path.includes(needle)) score = 2;
          else {
            let i = 0;
            for (const ch of file) if (ch === needle[i]) i += 1;
            if (i === needle.length) score = 1;
          }
          return { tab, score, length: file.length };
        })
        .filter((s) => s.score > 0)
        .sort((a, b) => b.score - a.score || a.length - b.length);
      const best = scored[0]?.tab;
      if (!best) {
        showMessage(`E345: Can't find file "${query.trim()}" in path`, true);
        return;
      }
      hideCmdline();
      navigate(best.dataset.path || '/');
    }

    function runCommand(raw: string) {
      const line = raw.trim();
      const [cmd = '', ...rest] = line.split(/\s+/);
      const arg = rest.join(' ');
      switch (cmd) {
        case '': hideCmdline(); break;
        case 'q': case 'q!': case 'wq': case 'x': case 'bd': case 'bdelete': hideCmdline(); closeBuffer(); break;
        case 'qa': case 'qa!': case 'qall': case 'wqa': sessionStorage.removeItem(OPENED_KEY); hideCmdline(); navigate('/'); break;
        case 'w': case 'write': showMessage("E45: 'readonly' option is set (add ! to override)", true); break;
        case 'w!': showMessage('"portfolio" is read-only, nothing written', true); break;
        case 'e': case 'edit': case 'find': fuzzyOpen(arg); break;
        case 'bn': case 'bnext': hideCmdline(); switchBuffer(1); break;
        case 'bp': case 'bprev': case 'bprevious': hideCmdline(); switchBuffer(-1); break;
        case 'h': case 'help': hideCmdline(); toggleHelp(true); break;
        case 'Telescope': case 'Tel': hideCmdline(); openTelescope(); break;
        case 'NvimTreeToggle': case 'Ex': case 'Explore': hideCmdline(); toggleTree(); break;
        case 'noh': case 'nohlsearch': hideCmdline(); break;
        default: showMessage(`E492: Not an editor command: ${line}`, true);
      }
    }

    // Item cursor: pages mark navigable cards with data-vim-item so hjkl step
    // between them instead of scrolling by line. Projects keeps its own grid.
    const items = () => [...document.querySelectorAll<HTMLElement>('[data-vim-item]')].filter((el) => !el.hidden && el.offsetParent !== null);
    let cursor = 0;

    function paint() {
      const list = items();
      document.querySelectorAll('.vim-cursor').forEach((el) => el.classList.remove('vim-cursor'));
      if (!list.length) return;
      cursor = Math.max(0, Math.min(cursor, list.length - 1));
      list[cursor].classList.add('vim-cursor');
    }
    function reveal() {
      items()[cursor]?.scrollIntoView({ block: 'nearest' });
    }
    function moveItem(delta: number) {
      const list = items();
      if (!list.length) return;
      cursor = Math.max(0, Math.min(list.length - 1, cursor + delta));
      paint();
      reveal();
    }
    // Rows are detected from layout so a 2-column grid and a 1-column list both
    // feel right: j/k go to the nearest card in the row below/above.
    function moveRow(dir: 1 | -1) {
      const list = items();
      if (!list.length) return;
      const cur = list[cursor].getBoundingClientRect();
      const cx = cur.left + cur.width / 2;
      const candidates = list
        .map((el, i) => ({ i, r: el.getBoundingClientRect() }))
        .filter(({ r }) => (dir === 1 ? r.top > cur.top + 1 : r.top < cur.top - 1));
      if (!candidates.length) return;
      const edge = dir === 1 ? Math.min(...candidates.map((c) => c.r.top)) : Math.max(...candidates.map((c) => c.r.top));
      const row = candidates.filter((c) => Math.abs(c.r.top - edge) < 1);
      row.sort((a, b) => Math.abs(a.r.left + a.r.width / 2 - cx) - Math.abs(b.r.left + b.r.width / 2 - cx));
      cursor = row[0].i;
      paint();
      reveal();
    }
    function jumpItem(index: number) {
      cursor = index;
      paint();
      reveal();
    }
    function activateItem() {
      const el = items()[cursor];
      if (!el) return;
      const target = el.matches('a[href], button, summary') ? el : el.querySelector<HTMLElement>('a[href], button, summary');
      target?.click();
    }
    function syncCursor(event: Event) {
      const el = (event.target as HTMLElement).closest<HTMLElement>('[data-vim-item]');
      const index = el ? items().indexOf(el) : -1;
      if (index >= 0 && index !== cursor) { cursor = index; paint(); }
    }

    function runSequence(seq: string): boolean {
      switch (seq) {
        case 'gg':
          if (items().length) jumpItem(0); else scrollTo(0);
          return true;
        case ']b': switchBuffer(1); return true;
        case '[b': switchBuffer(-1); return true;
        case ' e': toggleTree(); return true;
        case ' q': case ' bd': closeBuffer(); return true;
        case ' ?': toggleHelp(true); return true;
        case ' f': case ' b': setPending(seq); return true;
        case ' ff': openTelescope(); return true;
        case ' bn': switchBuffer(1); return true;
        case ' bp': switchBuffer(-1); return true;
      }
      return false;
    }

    const GRID_KEYS = ['h', 'j', 'k', 'l', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Enter', 'g', 'G', '/', 'Escape', '1', '2', '3'];

    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      const input = cmdInput();

      if (input && target === input) {
        if (event.key === 'Enter') { event.preventDefault(); runCommand(input.value); }
        else if (event.key === 'Escape') { event.preventDefault(); hideCmdline(); }
        return;
      }
      if (cmdOpen() && input?.hidden) {
        hideCmdline();
        if (event.key === 'Escape') { event.preventDefault(); return; }
      }
      if (telescopeOpen()) return;
      if (isTyping(target)) {
        if (event.key === 'Escape') target.blur();
        return;
      }
      const h = help();
      if (h && !h.hidden) {
        if (event.key === 'Escape' || event.key === '?') { event.preventDefault(); toggleHelp(false); }
        return;
      }
      if (event.altKey || event.metaKey) return;

      const editorEl = editor();
      const half = editorEl ? Math.round(editorEl.clientHeight / 2) : 300;
      const pageStep = editorEl ? Math.round(editorEl.clientHeight * 0.9) : 500;

      if (event.ctrlKey) {
        if (event.key === 'd') { event.preventDefault(); scrollBy(half); }
        else if (event.key === 'u') { event.preventDefault(); scrollBy(-half); }
        return;
      }

      const layer = document.querySelector<HTMLElement>('[data-vim-layer]')?.dataset.vimLayer;
      if (layer === 'grid' && GRID_KEYS.includes(event.key)) return;

      if (pending) {
        const seq = pending + event.key;
        setPending('');
        if (runSequence(seq)) { event.preventDefault(); return; }
      }

      const list = items();
      if (list.length) {
        // Enter on a focused link/button keeps its native behaviour.
        const nativeEnter = event.key === 'Enter' && Boolean(target.closest('a, button, summary'));
        switch (event.key) {
          case 'j': case 'ArrowDown': event.preventDefault(); moveRow(1); return;
          case 'k': case 'ArrowUp': event.preventDefault(); moveRow(-1); return;
          case 'h': case 'ArrowLeft': event.preventDefault(); moveItem(-1); return;
          case 'l': case 'ArrowRight': event.preventDefault(); moveItem(1); return;
          case 'G': event.preventDefault(); jumpItem(list.length - 1); return;
          case 'Enter': if (!nativeEnter) { event.preventDefault(); activateItem(); } return;
        }
      }

      switch (event.key) {
        case 'j': case 'ArrowDown': event.preventDefault(); scrollBy(LINE_STEP); break;
        case 'k': case 'ArrowUp': event.preventDefault(); scrollBy(-LINE_STEP); break;
        case 'PageDown': event.preventDefault(); scrollBy(pageStep); break;
        case 'PageUp': event.preventDefault(); scrollBy(-pageStep); break;
        case 'G': event.preventDefault(); scrollTo(editorEl ? editorEl.scrollHeight : 0); break;
        case 'g': case ']': case '[': event.preventDefault(); setPending(event.key); break;
        case ' ':
          if (!target.closest('a, button')) { event.preventDefault(); setPending(' '); }
          break;
        case ':': event.preventDefault(); openCmdline(); break;
        case '?': event.preventDefault(); toggleHelp(); break;
        case 'Escape': setPending(''); break;
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-vim-help]')) toggleHelp();
      else if (target.closest('[data-help-close]')) toggleHelp(false);
    });
    document.addEventListener('mouseover', syncCursor);
    document.addEventListener('focusin', syncCursor);
    document.addEventListener('focusin', refreshMode);
    document.addEventListener('focusout', () => window.setTimeout(refreshMode, 0));
    document.addEventListener('selectionchange', refreshMode);
    document.addEventListener('astro:page-load', () => { setPending(''); refreshMode(); cursor = 0; paint(); });
    paint();
  }

  initNvimTreeDrawer();
  initNvimTree();
  initStatusline();
  initBuffers();
  applyTreeHidden();
  initVim();
  document.addEventListener('astro:page-load', initNvimTreeDrawer);
  document.addEventListener('astro:page-load', initNvimTree);
  document.addEventListener('astro:page-load', initStatusline);
  document.addEventListener('astro:page-load', initBuffers);
  document.addEventListener('astro:page-load', applyTreeHidden);
</script>
