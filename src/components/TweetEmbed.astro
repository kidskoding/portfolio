---
interface Props {
  url: string;
}
const { url } = Astro.props;
const match = url.match(/status\/(\d+)/);
const tweetId = match ? match[1] : null;
const tweetUrl = url.split('?')[0];
---

{tweetId ? (
  <div class="my-6 flex justify-center [&_.twitter-tweet]:max-w-full!">
    <blockquote class="twitter-tweet" data-dnt="true">
      <a href={tweetUrl}>View tweet</a>
    </blockquote>
    <script async src="https://platform.twitter.com/widgets.js" charset="utf-8" />
  </div>
) : (
  <p class="my-4">
    <a href={url} target="_blank" rel="noopener noreferrer" class="text-accent underline">
      View post on X
    </a>
  </p>
)}
