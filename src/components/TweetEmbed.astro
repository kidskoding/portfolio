---
interface Props {
  url: string;
}
const { url } = Astro.props;
const match = url.match(/status\/(\d+)/);
const tweetId = match ? match[1] : null;
const tweetUrl = url.split('?')[0];
const widgetHref = tweetUrl.replace(/^https:\/\/x\.com/, 'https://twitter.com');
---

{tweetId ? (
  <div class="my-6 flex flex-col items-center gap-2 min-h-[400px]">
    <blockquote class="twitter-tweet" data-dnt="true" data-theme="dark">
      <a href={widgetHref}></a>
    </blockquote>
    <a href={tweetUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-accent hover:text-accent-hover underline">
      View on X
    </a>
  </div>
) : (
  <p class="my-4">
    <a href={url} target="_blank" rel="noopener noreferrer" class="text-accent underline">
      View post on X
    </a>
  </p>
)}
