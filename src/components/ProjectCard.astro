---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { languageColor } from '../data/language-colors';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, language, stack, cover, event, placement } = project.data;
const shownStack = stack.slice(0, 4);
const extra = stack.length - shownStack.length;
---

<a
  href={`/projects/${project.id}`}
  class="project-tile glow-card group flex min-w-0 flex-col transition-all duration-300 hover:bg-bg-card-hover"
  data-tile
  data-slug={project.id}
  data-search={[title, description, ...stack].join(' ').toLowerCase()}
  data-animate
>
  {cover && (
    <Image src={cover} alt="" widths={[480, 960]} sizes="(min-width: 640px) 50vw, 100vw" class="aspect-video w-full object-cover" />
  )}

  <div class="flex min-w-0 flex-1 flex-col gap-2 p-5">
    <div class="flex min-w-0 items-start justify-between gap-3">
      <span class="truncate text-sm font-semibold text-nvim-green">{title}</span>
      {(event || placement) && (
        <div class="flex shrink-0 flex-wrap justify-end gap-1.5">
          {event && <span class="font-mono text-[10px] font-semibold text-nvim-orange">{event}</span>}
          {placement && <span class="font-mono text-[10px] font-semibold text-nvim-purple">{placement}</span>}
        </div>
      )}
    </div>
    <p class="line-clamp-2 text-sm leading-relaxed text-text-secondary">{description}</p>
    <div class="mt-auto flex flex-wrap items-center gap-2 pt-3">
      {language && (
        <span class="mr-1 flex items-center gap-1.5 text-xs text-nvim-gray">
          <span class="h-2.5 w-2.5 shrink-0 rounded-full" style={`background-color: ${languageColor(language)}`} />
          {language}
        </span>
      )}
      {shownStack.map((tag) => <span class="border border-border-subtle bg-bg-secondary px-2 py-0.5 font-mono text-xs text-nvim-yellow">{tag}</span>)}
      {extra > 0 && <span class="border border-border-subtle bg-bg-secondary px-2 py-0.5 font-mono text-xs text-nvim-yellow">+{extra}</span>}
    </div>
  </div>
</a>

<style>
  .project-tile { outline: 1px solid transparent; outline-offset: -1px; }
  .project-tile[hidden] { display: none; }
  .project-tile.tile-cursor,
  .project-tile:focus-visible { outline-color: var(--color-nvim-yellow); }
</style>

<script>
  function initGlow() {
    document.querySelectorAll<HTMLElement>('.glow-card').forEach((card) => {
      if (card.dataset.glowBound === 'true') return;
      card.dataset.glowBound = 'true';
      card.addEventListener('mousemove', (event) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`);
      });
    });
  }
  initGlow();
  document.addEventListener('astro:page-load', initGlow);
</script>
