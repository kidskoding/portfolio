---
import TelescopePalette, { type EggItem, type EntryItem, type PageItem } from './TelescopePalette';

interface Props {
  posts: EntryItem[];
  projects: EntryItem[];
}

const { posts, projects } = Astro.props;

const pages: PageItem[] = [
  { label: 'index.astro', path: '/', desc: 'building ai agents' },
  { label: 'experience.astro', path: '/experience', desc: 'my education and work experience' },
  { label: 'skills.astro', path: '/skills', desc: 'the tools, languages, and platforms I use to build products' },
  { label: 'about.astro', path: '/about', desc: "who I am, what I do, and what I'm into" },
  { label: 'projects.astro', path: '/projects', desc: 'things built' },
  { label: 'certificates.astro', path: '/certificates', desc: "licenses and certifications I've earned" },
  {
    label: 'contact.astro',
    path: '/contact',
    desc: 'contact me if you want to stay in touch! collaboration, questions, or just simply saying hi :)',
  },
  { label: 'license.astro', path: '/license', desc: 'what you can reuse, and what this site borrows' },
  {
    label: 'blog-posts/index.mdx',
    path: '/blog',
    icon: 'mdx',
    desc: 'my blog posts covering various tech news! takes on AI, startups, and where the industry is headed.',
  },
  {
    label: 'health://',
    path: '/checkhealth',
    desc: 'the font, colorscheme, and neovim plugins behind this site',
    icon: 'checkhealth',
  },
];

const easterEggs: EggItem[] = [
  { cmd: 'sudo hire-me', response: 'elevated privileges granted - anirudhkonidala@gmail.com' },
  { cmd: 'rm -rf /', response: 'Permission denied: this portfolio is read-only' },
  { cmd: 'git blame', response: 'all commits by Anirudh Konidala, no exceptions' },
];
---

<!-- persisted so the palette keeps one listener and its state across soft navigation -->
<TelescopePalette client:load transition:persist pages={pages} posts={posts} projects={projects} eggs={easterEggs} />

<style is:global>
  .telescope-overlay {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .telescope-overlay.open {
    pointer-events: all;
    opacity: 1;
  }
  .telescope-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 8, 5, 0.8);
  }
  .telescope-modal {
    position: relative;
    background: var(--color-nvim-bg1);
    border: 1px solid var(--color-nvim-bg3);
    /* Telescope floats at a large share of the editor; capped so one result list doesn't look empty */
    width: min(70vw, 820px);
    max-width: calc(100vw - 32px);
    height: min(65vh, 600px);
    max-height: calc(100vh - 32px);
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
    z-index: 1;
    overflow: hidden;
  }
  .telescope-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--color-nvim-bg2);
    border-bottom: 1px solid var(--color-nvim-bg3);
    flex-shrink: 0;
  }
  .telescope-icon {
    color: var(--color-nvim-blue);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 700;
  }
  .telescope-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: var(--text-sm);
    color: var(--color-nvim-fg);
    font-family: var(--font-mono);
    caret-color: var(--color-nvim-yellow);
  }
  .telescope-input::placeholder {
    color: var(--color-nvim-gray);
  }

  .telescope-hint {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-nvim-fg2);
  }
  .telescope-body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }
  .telescope-results {
    flex: 1;
    overflow-y: auto;
    padding: 4px 0;
  }
  .telescope-results::-webkit-scrollbar {
    width: 3px;
  }
  .telescope-results::-webkit-scrollbar-thumb {
    background: var(--color-nvim-bg3);
  }
  .telescope-section {
    padding: 5px 14px 2px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-nvim-fg2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--color-nvim-bg);
  }
  .telescope-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    font-size: var(--text-sm);
    cursor: pointer;
    transition: background 0.1s;
  }
  .telescope-item:hover,
  .telescope-item.selected {
    background: var(--color-nvim-bg2);
  }
  .telescope-item.selected {
    border-left: 2px solid var(--color-nvim-yellow);
    padding-left: 12px;
  }
  .item-icon {
    font-size: var(--text-sm);
    font-weight: 700;
    width: 24px;
    height: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex-shrink: 0;
  }
  .telescope-item .icon-astro {
    color: var(--color-devicon-astro);
  }
  .telescope-item .icon-mdx {
    color: var(--color-devicon-mdx);
  }
  .telescope-item .icon-checkhealth {
    color: var(--color-devicon-checkhealth);
  }
  .telescope-item .icon-astro,
  .telescope-item .icon-mdx,
  .telescope-item .icon-checkhealth {
    font-size: var(--text-base);
    font-family: 'JetBrains Mono Nerd Font Icons', var(--font-mono);
    font-weight: 400;
  }
  .item-label {
    color: var(--color-nvim-fg);
    flex: 1;
  }
  .item-sub {
    color: var(--color-nvim-fg2);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    min-width: 0;
    max-width: 55%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .item-easter {
    color: var(--color-nvim-orange);
  }
  .item-enter {
    font-size: var(--text-sm);
    color: var(--color-nvim-fg2);
    font-family: var(--font-mono);
    background: var(--color-nvim-bg);
    padding: 1px 5px;
  }
  .telescope-preview {
    width: 200px;
    border-left: 1px solid var(--color-nvim-bg3);
    background: var(--color-nvim-bg);
    padding: 10px 12px;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-nvim-fg2);
    flex-shrink: 0;
  }
  .preview-label {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 8px;
    color: var(--color-nvim-fg2);
  }
  .preview-content {
    line-height: 1.8;
    color: var(--color-nvim-fg2);
    font-size: var(--text-sm);
    white-space: pre-line;
    word-break: break-word;
  }
  .egg-result {
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-nvim-green);
    border-top: 1px solid var(--color-nvim-bg3);
  }
  .egg-result.error {
    color: var(--color-nvim-red);
  }
</style>
