---
export interface LegendItem {
  label: string;
  color: string;
}

interface Props {
  title: string;
  subtitle?: string;
  kind: 'hbar' | 'dumbbell' | 'scatter' | 'simulator';
  data: Record<string, unknown>;
  options: Record<string, unknown>;
  height: number;
}

const { title, subtitle, kind, data, options, height } = Astro.props;
const views = (data.views as { key: string; label: string }[] | undefined) ?? [];
---

<figure class="cjs-chart">
  <div class="chart-title">{title}</div>
  {subtitle && <div class="chart-sub">{subtitle}</div>}
  {views.length > 1 && (
    <div class="chart-views" role="tablist">
      {views.map((v, i) => (
        <button type="button" role="tab" data-view={v.key} aria-selected={i === 0 ? 'true' : 'false'}>
          {v.label}
        </button>
      ))}
    </div>
  )}
  {kind === 'simulator' && (
    <div class="chart-sliders">
      <label>
        <span>Allergy-safe candies</span>
        <input type="range" min="0" max="10" step="1" value="1" data-safe-count />
        <output>1 of 10</output>
      </label>
      <div class="chart-stats" aria-live="polite"></div>
    </div>
  )}
  <div class="chart-canvas" style={`height: ${height}px`}>
    <canvas role="img" aria-label={title}></canvas>
  </div>
  <script type="application/json" set:html={JSON.stringify({ kind, data, options })} />
</figure>

<style is:global>
  .cjs-chart {
    margin: 1.75rem 0;
    padding: 1.25rem 1.25rem 0.75rem;
    background: var(--color-nvim-bg);
    border: 1px solid var(--color-nvim-bg2);
    border-radius: 0.5rem;
  }
  .cjs-chart .chart-title {
    color: var(--color-nvim-fg);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .cjs-chart .chart-sub {
    color: var(--color-nvim-fg2);
    font-size: 0.85rem;
    margin-top: 0.35rem;
  }
  .cjs-chart .chart-canvas {
    position: relative;
    margin-top: 0.75rem;
  }
  .cjs-chart .chart-views {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .cjs-chart .chart-views button {
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--color-nvim-bg3);
    border-radius: 0.375rem;
    background: none;
    color: var(--color-nvim-fg2);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .cjs-chart .chart-views button[aria-selected='true'] {
    background: var(--color-nvim-bg2);
    color: var(--color-nvim-fg);
    border-color: var(--color-nvim-fg3);
  }
  .cjs-chart .chart-sliders {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.9rem;
    font-size: 0.8rem;
    color: var(--color-nvim-fg);
  }
  .cjs-chart .chart-sliders label {
    display: grid;
    grid-template-columns: 9rem 1fr 7rem;
    align-items: center;
    gap: 0.75rem;
  }
  .cjs-chart .chart-sliders input {
    accent-color: var(--color-nvim-aqua);
  }
  .cjs-chart .chart-sliders output {
    color: var(--color-nvim-fg2);
  }
  .cjs-chart .chart-stats {
    color: var(--color-nvim-fg2);
    margin-top: 0.25rem;
  }
  .cjs-chart .cjs-tip {
    position: absolute;
    z-index: 20;
    width: max-content;
    max-width: min(18rem, 100%);
    padding: 0.55rem 0.7rem;
    background: var(--color-nvim-bg-hard);
    border: 1px solid var(--color-nvim-bg3);
    border-radius: 0.375rem;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.4);
    color: var(--color-nvim-fg);
    font-size: 0.78rem;
    line-height: 1.45;
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 120ms ease-out,
      transform 120ms ease-out;
  }
  .cjs-chart .cjs-tip.show {
    opacity: 1;
    transform: translateY(0);
  }
  .cjs-chart .cjs-tip::after {
    content: '';
    position: absolute;
    left: calc(var(--arrow-x, 50%) - 6px);
    top: 100%;
    border: 6px solid transparent;
    border-top-color: var(--color-nvim-bg3);
  }
  .cjs-chart .cjs-tip.below::after {
    top: auto;
    bottom: 100%;
    border-top-color: transparent;
    border-bottom-color: var(--color-nvim-bg3);
  }
  .cjs-chart .cjs-tip-title {
    color: var(--color-nvim-yellow);
    font-weight: 700;
    margin-bottom: 0.15rem;
  }
  .cjs-chart .cjs-tip-gap {
    height: 0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .cjs-chart .cjs-tip {
      transition: none;
    }
  }
  @media (max-width: 640px) {
    .cjs-chart .chart-sliders label {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>

<script>
  import { mountChart } from '../../lib/charts';

  // the site uses Astro's client router, so mount on every page load, not just the first
  document.addEventListener('astro:page-load', () => {
    for (const fig of document.querySelectorAll<HTMLElement>('.cjs-chart')) mountChart(fig);
  });
</script>
