---
import { version } from '../../package.json';

const repo = 'https://github.com/kidskoding/portfolio';
const linkedin = 'https://www.linkedin.com/in/anirudh-konidala';

type Cell = { ch: string; orange: boolean };
const cells = (row: string, orangeCount: number): Cell[] => [...row].map((ch, i) => ({ ch, orange: i < orangeCount }));
const logo = [cells('│ ╲ ││', 1), cells('││╲╲││', 2), cells('││ ╲ │', 2)];

const groups = [
  [
    { cmd: 'e index.astro', desc: 'for the tl;dr' },
    { cmd: 'e about.astro', desc: 'to meet me' },
    { cmd: 'e experience.astro', desc: 'for my resume' },
    { cmd: 'Telescope', desc: 'to find anything' },
    { cmd: 'help', desc: 'for keys' },
  ],
  [{ cmd: 'e package.json', desc: 'to see my deps' }],
];
const all = groups.flat();
const cmdWidth = Math.max(...all.map(({ cmd }) => `:${cmd}<Enter>`.length)) + 3;
const descWidth = Math.max(...all.map(({ desc }) => desc.length));
const pad = (cmd: string) => ' '.repeat(cmdWidth - `:${cmd}<Enter>`.length);
---

<section
  class="intro flex min-h-[70vh] flex-col items-center justify-center py-8 text-sm sm:text-base"
  aria-label="Intro"
>
  <div class="mx-auto w-fit max-w-full text-center text-nvim-fg" data-animate>
    <div aria-hidden="true">
      {logo.map((row) => (
        <div class="logo-row">
          {row.map(({ ch, orange }) => (
            <span class:list={['cell', orange ? 'text-nvim-orange' : 'text-nvim-green']}>
              {ch !== ' ' && (
                <svg viewBox="0 0 1 2" preserveAspectRatio="none">
                  {ch === '│' ? <line x1="0.5" y1="0" x2="0.5" y2="2" /> : <line x1="0" y1="0" x2="1" y2="2" />}
                </svg>
              )}
            </span>
          ))}
        </div>
      ))}
      <div class="blank"></div>
    </div>
    <p class="line text-nvim-green">ANIRUDH KONIDALA v{version}</p>
    <div class="sep" aria-hidden="true"></div>
    <p class="line">This is the portfolio of Anirudh Konidala,</p>
    <p class="line">
      which is open source and freely distributable on{' '}
      <a class="text-nvim-blue hover:text-nvim-aqua" href={repo} target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
    </p>
    <a class="line text-nvim-blue hover:text-nvim-aqua" href={linkedin} target="_blank" rel="noopener noreferrer">
      {linkedin.replace('https://www.', '')}
    </a>
    {groups.map((rows) => (
      <>
        <div class="sep" aria-hidden="true" />
        <div class="mx-auto w-fit text-left">
          {rows.map(({ cmd, desc }) => (
            <button type="button" class:list={['line intro-row', { 'keys-only': cmd === 'help' }]} data-nvim-cmd={cmd}>
              <span class="verb-type">{'type  '}</span>
              <span class="verb-tap">{'tap   '}</span>
              <span class="text-nvim-bg3">:</span>
              <span class="cmd text-nvim-blue">{cmd}</span>
              <span class="enter text-nvim-bg3">&lt;Enter&gt;</span>
              <span class="hidden sm:inline">{pad(cmd) + desc.padEnd(descWidth)}</span>
            </button>
          ))}
        </div>
      </>
    ))}
    <div class="sep" aria-hidden="true"></div>
    <p class="line">not a vim user? no problem</p>
    <p class="line">
      <span class="verb-type">click</span>
      <span class="verb-tap">tap</span> on a row above, or pick a file from <span class="tree-chip">☰ NvimTree</span>
    </p>
  </div>
</section>

<style>
  .intro {
    line-height: 2ch;
  }
  .line {
    display: block;
    white-space: pre-wrap;
  }
  .tree-chip {
    border: 1px solid var(--color-nvim-bg3);
    background: var(--color-nvim-bg1);
    color: var(--color-nvim-fg2);
    padding: 0 5px;
    white-space: nowrap;
  }
  .blank {
    height: 2ch;
  }
  .logo-row {
    display: flex;
    justify-content: center;
  }
  .cell {
    display: inline-block;
    width: 1ch;
    height: 2ch;
  }
  .cell svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .cell line {
    stroke: currentColor;
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
  }
  .sep {
    height: 2ch;
    background: linear-gradient(var(--color-nvim-bg3), var(--color-nvim-bg3)) center / 100% 1px no-repeat;
  }
  .intro-row {
    width: 100%;
    font: inherit;
    cursor: pointer;
  }
  .verb-tap {
    display: none;
  }
  /* Touch screens have no keyboard: rows are tapped, so drop "type", <Enter> and the key help row */
  @media (hover: none) {
    .cmd {
      text-decoration: underline dotted;
      text-underline-offset: 3px;
    }
    .verb-type,
    .enter,
    .keys-only {
      display: none;
    }
    .verb-tap {
      display: inline;
    }
  }
  .intro-row:hover {
    background: var(--color-nvim-bg1);
  }
  .intro-row:focus-visible {
    outline: 1px solid var(--color-nvim-yellow);
    outline-offset: -1px;
  }
</style>
