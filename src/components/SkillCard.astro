---
interface Props {
	name: string;
	svg?: string;
	hideIcon?: boolean;
}

const { name, svg, hideIcon = false } = Astro.props;

const fallbackLetters = name
	.split(/[^A-Za-z0-9]+/)
	.filter(Boolean)
	.map((part) => part[0])
	.join("")
	.slice(0, 2)
	.toUpperCase();
---

<div
	class="rounded-lg border border-border-subtle bg-bg-card p-3 flex flex-col items-center justify-center gap-2 aspect-square text-center"
>
	{hideIcon ? null : svg ? (
		<span class="w-12 h-12 shrink-0 rounded-md flex items-center justify-center bg-white/8 ring-1 ring-white/12">
			<span class="w-8 h-8 [&>svg]:w-full [&>svg]:h-full" set:html={svg} />
		</span>
	) : (
		<span class="w-12 h-12 shrink-0 rounded-md flex items-center justify-center bg-white/8 ring-1 ring-white/12 text-sm font-bold text-text-secondary">
			{fallbackLetters}
		</span>
	)}
	<span class="text-sm font-medium text-text-primary leading-tight mt-2">{name}</span>
</div>
