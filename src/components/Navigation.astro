---
interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

const navLinks = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
  { name: "Resume", href: "/experience" },
  { name: "Projects", href: "/projects" },
  { name: "Skills", href: "/skills" },
  { name: "Blog", href: "/blog" },
  { name: "Contact", href: "/contact" }
];

const otherLinks = [
  {
    name: "GitHub",
    href: "https://github.com/kidskoding",
    path: "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.412-4.041-1.412-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z",
    isImage: false
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/anirudh-konidala",
    path: "M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z",
    isImage: false
  },
  {
    name: "Dev",
    href: "https://dev.to/anikoni2010",
    isImage: true,
    imageSrc: devToIcon.src
  }
];

import devToIcon from '../assets/fi-swluxl-dev-to.png';
---

<nav class="fixed top-0 left-0 right-0 z-50" id="main-nav" transition:persist>
    <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    </div>
</nav>

<!-- Sidebar (always visible) -->
<aside
    id="mobile-sidebar"
    class="fixed top-16 left-0 bottom-0 z-40 w-72 bg-bg-primary border-r border-border-subtle flex flex-col"
    transition:persist
>
    <div class="px-6 pt-1 pb-3 text-center">
        <a href="/" class="text-lg font-bold tracking-tight transition-colors duration-200 text-accent">
            Anirudh Konidala
        </a>
    </div>
    <nav class="flex-1 flex flex-col gap-1 px-6">
        {navLinks.map((link) => (
            <a
                href={link.href}
                data-nav-link
                data-href={link.href}
                class="nav-link relative px-4 py-3 text-base font-medium rounded-lg text-text-muted hover:text-text-primary hover:bg-white/5 transition-all duration-200 text-center"
            >
                {link.name}
                <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-5 h-0.5 rounded-full bg-linear-to-r from-accent to-accent-secondary opacity-0 transition-opacity duration-200" />
            </a>
        ))}
    </nav>

    <div class="mt-auto px-6 py-6 border-t border-border-subtle flex items-center justify-center gap-3">
        {otherLinks.map((link) => (
            <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-9 h-9 flex items-center justify-center rounded-full border border-white/10 text-text-muted hover:text-text-primary hover:bg-white/10 transition-all group"
            >
                {link.isImage ? (
                    <img src={link.imageSrc} alt={link.name} class="w-5 h-5 transition-transform group-hover:scale-110" />
                ) : (
                    <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
                        <path d={link.path} />
                    </svg>
                )}
            </a>
        ))}
    </div>
</aside>

<div class="h-16" />

<script>
    function initNav() {
        const nav = document.getElementById('main-nav');
        if (!nav) return;

        function updateActiveLink() {
            const path = window.location.pathname;
            document.querySelectorAll('[data-nav-link]').forEach((link) => {
                const href = link.getAttribute('data-href');
                const isActive = href === path || (href === '/' && path === '/');
                const indicator = link.querySelector('.nav-indicator') as HTMLElement;

                if (isActive) {
                    link.classList.remove('text-text-muted', 'hover:text-text-primary', 'hover:bg-white/3');
                    link.classList.add('text-text-primary', 'bg-accent-subtle');
                    if (indicator) indicator.style.opacity = '1';
                } else {
                    link.classList.add('text-text-muted', 'hover:text-text-primary', 'hover:bg-white/3');
                    link.classList.remove('text-text-primary', 'bg-accent-subtle');
                    if (indicator) indicator.style.opacity = '0';
                }
            });
        }

        function updateScroll() {
            if (window.scrollY > 20) {
                nav!.style.background = 'rgba(10, 10, 15, 0.7)';
                nav!.style.backdropFilter = 'blur(20px) saturate(1.5)';
                nav!.style.borderBottom = '1px solid rgba(107, 140, 254, 0.08)';
            } else {
                nav!.style.background = 'transparent';
                nav!.style.backdropFilter = 'none';
                nav!.style.borderBottom = '1px solid transparent';
            }
        }

        window.addEventListener('scroll', updateScroll, { passive: true });
        updateScroll();
        updateActiveLink();

        document.addEventListener('astro:after-swap', updateActiveLink);
    }

    initNav();
</script>
