---
const navLinks = [
  { name: "Home", href: "/" },
  { name: "Resume", href: "/experience" },
  { name: "Skills", href: "/skills" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
  { name: "Projects", href: "/projects" },
  { name: "Blog", href: "/blog" },
];

const otherLinks = [
  {
    name: "GitHub",
    href: "https://github.com/kidskoding",
    path: "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.412-4.041-1.412-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z",
    isImage: false
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/anirudh-konidala",
    path: "M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z",
    isImage: false
  },
  {
    name: "Dev",
    href: "https://dev.to/anikoni2010",
    isImage: true,
    imageSrc: devToIcon.src
  }
];

import devToIcon from '../assets/fi-swluxl-dev-to.png';
---

<nav class="fixed top-0 left-0 right-0 z-50" id="main-nav" transition:persist aria-label="Site header">
    <div class="h-16 flex items-center px-4 sm:px-6 lg:pl-8">
        <button
            type="button"
            id="nav-menu-toggle"
            class="lg:hidden inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-border-default text-text-primary hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors"
            aria-controls="mobile-sidebar"
            aria-expanded="false"
            aria-label="Open menu"
        >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path id="nav-icon-open" stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
                <path id="nav-icon-close" class="hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
            </svg>
        </button>
    </div>
</nav>

<div
    id="nav-backdrop"
    class="fixed inset-0 top-16 z-30 bg-bg-primary/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
></div>

<!-- Sidebar: off-canvas drawer on small viewports; fixed column on lg+ -->
<aside
    id="mobile-sidebar"
    class="fixed top-16 left-0 bottom-0 z-40 flex w-[min(18rem,calc(100vw-2rem))] max-w-[85vw] flex-col border-r border-border-subtle bg-bg-primary shadow-lg lg:shadow-none lg:max-w-none"
    transition:persist
    aria-label="Primary"
>
    <div class="px-6 pt-1 pb-3 text-center">
        <a href="/" class="text-lg font-bold tracking-tight transition-colors duration-200 text-accent">
            Anirudh Konidala
        </a>
    </div>
    <nav class="flex flex-1 flex-col gap-1 overflow-y-auto px-6 pb-4">
        {navLinks.map((link) => (
            <a
                href={link.href}
                data-nav-link
                data-href={link.href}
                class="nav-link relative rounded-lg px-4 py-3 text-center text-base font-medium text-text-muted transition-all duration-200 hover:bg-white/5 hover:text-text-primary"
            >
                {link.name}
                <span class="nav-indicator absolute bottom-0 left-1/2 h-0.5 w-5 -translate-x-1/2 rounded-full bg-linear-to-r from-accent to-accent-secondary opacity-0 transition-opacity duration-200" />
            </a>
        ))}
    </nav>

    <div class="mt-auto flex items-center justify-center gap-3 border-t border-border-subtle px-6 py-6 pb-[max(1.5rem,env(safe-area-inset-bottom))]">
        {otherLinks.map((link) => (
            <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-text-muted transition hover:bg-white/10 hover:text-text-primary"
            >
                {link.isImage ? (
                    <img src={link.imageSrc} alt={link.name} class="h-5 w-5 transition-transform group-hover:scale-110" />
                ) : (
                    <svg class="h-5 w-5 transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
                        <path d={link.path} />
                    </svg>
                )}
            </a>
        ))}
    </div>
</aside>

<div class="h-16" />

<script>
    function initNav() {
        const nav = document.getElementById('main-nav');
        const sidebar = document.getElementById('mobile-sidebar');
        const backdrop = document.getElementById('nav-backdrop');
        const toggle = document.getElementById('nav-menu-toggle');
        const iconOpen = document.getElementById('nav-icon-open');
        const iconClose = document.getElementById('nav-icon-close');

        if (!nav || !sidebar || !backdrop || !toggle) return;

        const elNav = nav;
        const elSidebar = sidebar;
        const elBackdrop = backdrop;
        const elToggle = toggle;

        const mq = window.matchMedia('(min-width: 1024px)');
        const alreadyInit = elNav.dataset.navInitialized === 'true';

        function isDesktop() {
            return mq.matches;
        }

        function setMenuIcons(open: boolean) {
            if (!iconOpen || !iconClose) return;
            iconOpen.classList.toggle('hidden', open);
            iconClose.classList.toggle('hidden', !open);
            elToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        }

        function setNavOpen(open: boolean) {
            if (isDesktop()) {
                elSidebar.classList.remove('is-open');
                elBackdrop.classList.remove('is-open');
                elBackdrop.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('overflow-hidden');
                elToggle.setAttribute('aria-expanded', 'false');
                setMenuIcons(false);
                return;
            }

            elSidebar.classList.toggle('is-open', open);
            elBackdrop.classList.toggle('is-open', open);
            elBackdrop.setAttribute('aria-hidden', open ? 'false' : 'true');
            document.body.classList.toggle('overflow-hidden', open);
            elToggle.setAttribute('aria-expanded', String(open));
            setMenuIcons(open);
        }

        function toggleNav() {
            if (isDesktop()) return;
            setNavOpen(!elSidebar.classList.contains('is-open'));
        }

        function updateActiveLink() {
            const path = window.location.pathname;
            document.querySelectorAll('[data-nav-link]').forEach((link) => {
                const href = link.getAttribute('data-href');
                const isActive =
                    href === path ||
                    (href === '/' && path === '/') ||
                    (href === '/blog' && path.startsWith('/blog'));
                const indicator = link.querySelector('.nav-indicator') as HTMLElement;

                if (isActive) {
                    link.classList.remove('text-text-muted', 'hover:text-text-primary', 'hover:bg-white/3');
                    link.classList.add('text-text-primary', 'bg-accent-subtle');
                    if (indicator) indicator.style.opacity = '1';
                } else {
                    link.classList.add('text-text-muted', 'hover:text-text-primary', 'hover:bg-white/3');
                    link.classList.remove('text-text-primary', 'bg-accent-subtle');
                    if (indicator) indicator.style.opacity = '0';
                }
            });
        }

        function updateScroll() {
            if (window.scrollY > 20) {
                elNav.style.background = 'rgba(10, 10, 15, 0.7)';
                elNav.style.backdropFilter = 'blur(20px) saturate(1.5)';
                elNav.style.borderBottom = '1px solid rgba(107, 140, 254, 0.08)';
            } else {
                elNav.style.background = 'transparent';
                elNav.style.backdropFilter = 'none';
                elNav.style.borderBottom = '1px solid transparent';
            }
        }

        function onMqChange() {
            if (isDesktop()) {
                setNavOpen(false);
            }
        }

        if (alreadyInit) {
            updateActiveLink();
            onMqChange();
            return;
        }

        elNav.dataset.navInitialized = 'true';

        elToggle.addEventListener('click', toggleNav);
        elBackdrop.addEventListener('click', () => setNavOpen(false));

        document.querySelectorAll('[data-nav-link]').forEach((link) => {
            link.addEventListener('click', () => {
                if (!isDesktop()) setNavOpen(false);
            });
        });

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && elSidebar.classList.contains('is-open')) {
                setNavOpen(false);
                elToggle.focus();
            }
        });

        mq.addEventListener('change', onMqChange);

        window.addEventListener('scroll', updateScroll, { passive: true });
        updateScroll();
        updateActiveLink();
        onMqChange();

        document.addEventListener('astro:page-load', () => {
            updateActiveLink();
            onMqChange();
        });
    }

    initNav();
</script>

<style is:global>
    #nav-backdrop.is-open {
        opacity: 1;
        pointer-events: auto;
    }
</style>
