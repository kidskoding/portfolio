---
/**
 * Inline vim/lualine mode chip for blog prose (gruvbox mode colors).
 * Normal yellow, Insert blue, Visual orange, Command green, Terminal purple.
 */
interface Props {
  mode: 'normal' | 'insert' | 'visual' | 'command' | 'terminal';
}

const { mode } = Astro.props;

const labels = {
  normal: 'Normal',
  insert: 'Insert',
  visual: 'Visual',
  command: 'Command',
  terminal: 'Terminal',
} as const;
---

<span class={`vim-mode vim-mode-${mode}`}>{labels[mode]}</span>

<style is:global>
  .blog-content .vim-mode {
    display: inline-block;
    padding: 0 0.45em;
    margin: 0 0.05em;
    border-radius: 0.15em;
    font-weight: 700;
    font-size: 0.92em;
    line-height: 1.45;
    vertical-align: baseline;
    color: var(--color-nvim-bg);
  }

  .blog-content .vim-mode-normal {
    background: var(--color-nvim-yellow);
  }

  .blog-content .vim-mode-insert {
    background: var(--color-nvim-blue);
  }

  .blog-content .vim-mode-visual {
    background: var(--color-nvim-orange);
  }

  .blog-content .vim-mode-command {
    background: var(--color-nvim-green);
  }

  .blog-content .vim-mode-terminal {
    background: var(--color-nvim-purple);
  }
</style>
