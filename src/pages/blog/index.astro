---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { getCollection } from 'astro:content';
import profileImg from '../../assets/my-profile-pic.jpg';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog">
  <Navigation />
  <main class="max-w-3xl w-full min-w-0 mx-auto px-6 py-12 lg:mx-0 lg:ml-72 lg:mr-auto" id="main-content">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-3" data-animate>Blog</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight gradient-text" data-animate>Blog</h1>
    <p class="text-text-muted mt-3 text-base max-w-md" data-animate>
      my blog posts covering various tech news! takes on AI, startups, and where the industry is headed.
    </p>

    <ul class="mt-10 space-y-6" data-animate>
      {posts.map((post) => (
        <li>
          <a
            href={`/blog/${post.id}`}
            class="block rounded-xl border border-border-subtle bg-bg-card p-6 transition-all hover:bg-bg-card-hover hover:border-border-accent group"
          >
            <h2 class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">
              {post.data.title}
            </h2>
            {post.data.description && (
              <p class="text-text-muted text-sm mt-1">{post.data.description}</p>
            )}
            <p class="text-text-muted text-xs mt-2 flex items-center gap-2 flex-wrap">
              <img src={profileImg.src} alt="" class="w-5 h-5 rounded-full object-cover shrink-0" />
              <span>Anirudh Konidala</span>
              <span class="opacity-60" aria-hidden="true">·</span>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
