---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectsGallery from '../components/islands/ProjectsGallery';
import Layout from '../layouts/Layout.astro';
import { byProjectOrderThenDate } from '../data/project-sort';

const projects = await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft);
const tabs = [
  { key: 'projects', label: 'projects', category: 'project' },
  { key: 'hackathons', label: 'hackathons', category: 'hackathon' },
  { key: 'agentic', label: 'agentic ai @ uiuc work samples', category: 'agentic' },
] as const;
const groups = tabs.map((tab) => ({
  ...tab,
  items: projects.filter((project) => project.data.category === tab.category).sort(byProjectOrderThenDate),
}));
---

<Layout title="Projects">
  <main class="mx-auto w-full max-w-4xl px-6 py-8" id="main-content" data-vim-layer="grid">
    <div data-animate>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-nvim-green">Projects</p>
      <h1 class="gradient-text text-4xl font-bold tracking-tight md:text-5xl">Projects</h1>
      <p class="mt-3 text-base text-text-muted">things i've built. click on a tile!</p>
    </div>

    <ProjectsGallery client:load groups={groups.map(({ key, label }) => ({ key, label }))}>
      {groups.map((group) => (
        <Fragment slot={`panel-${group.key}`}>
          {group.items.map((project) => (
            <ProjectCard project={project} />
          ))}
        </Fragment>
      ))}
    </ProjectsGallery>

    <p class="mt-10 text-sm" data-animate>
      <a
        href="https://github.com/kidskoding"
        target="_blank"
        rel="noopener noreferrer"
        class="text-nvim-blue hover:underline"
      >
        more on github &rarr;
      </a>
    </p>
  </main>
</Layout>

<style is:global>
  .tab-btn[aria-selected='true'] {
    color: var(--color-nvim-green);
    border-color: var(--color-nvim-yellow);
  }
  .tab-btn[aria-selected='false'] {
    color: var(--color-text-muted);
    border-color: transparent;
  }
</style>
