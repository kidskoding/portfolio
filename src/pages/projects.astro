---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects, hackathons, aiAgents, dsaProjects, otherProjects } from '../data/projects';
---

<Layout title="Projects">
    <Navigation currentPage="projects" />
    <main class="max-w-3xl mx-auto px-6 py-12" id="main-content">
        <div data-animate>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-3">Projects</p>
            <h1 class="text-4xl md:text-5xl font-bold tracking-tight gradient-text">Projects</h1>
            <p class="text-text-muted mt-3 text-base max-w-md">things i've built</p>
        </div>

        <!-- Currently Working On (client-rendered) -->
        <div id="currently-working-on" class="mt-10 hidden" data-animate>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent/70 mb-4 text-center">Currently Working On</p>
            <div class="max-w-sm mx-auto" id="current-repo-card"></div>
        </div>

        <!-- Tab bar -->
        <div class="flex gap-2 mt-10 border-b border-border-subtle" data-animate>
            <button
                class="tab-btn px-4 py-2.5 text-sm font-medium transition-colors duration-200 border-b-2 -mb-px"
                data-tab="featured"
            >
                Featured
            </button>
            <button
                class="tab-btn px-4 py-2.5 text-sm font-medium transition-colors duration-200 border-b-2 -mb-px"
                data-tab="hackathons"
            >
                Hackathons
            </button>
            <button
                class="tab-btn px-4 py-2.5 text-sm font-medium transition-colors duration-200 border-b-2 -mb-px"
                data-tab="ai-agents"
            >
                100 AI Agents
            </button>
            <button
                class="tab-btn px-4 py-2.5 text-sm font-medium transition-colors duration-200 border-b-2 -mb-px"
                data-tab="dsa"
            >
                DSA
            </button>
            <button
                class="tab-btn px-4 py-2.5 text-sm font-medium transition-colors duration-200 border-b-2 -mb-px"
                data-tab="other"
            >
                Other
            </button>
        </div>

        <!-- Featured -->
        <div id="tab-featured" class="tab-panel mt-6">
            {featuredProjects.length > 0 ? (
                <div class="grid gap-4 sm:grid-cols-2">
                    {featuredProjects.map((project) => (
                        <ProjectCard project={project} />
                    ))}
                </div>
            ) : (
                <p class="text-text-muted text-sm mt-4">Coming soon.</p>
            )}
        </div>

        <!-- Hackathons -->
        <div id="tab-hackathons" class="tab-panel mt-6 hidden">
            {hackathons.length > 0 ? (
                <div class="grid gap-4 sm:grid-cols-2">
                    {hackathons.map((project) => (
                        <ProjectCard project={project} />
                    ))}
                </div>
            ) : (
                <p class="text-text-muted text-sm mt-4">Coming soon.</p>
            )}
        </div>

        <!-- 100 AI Agents -->
        <div id="tab-ai-agents" class="tab-panel mt-6 hidden">
            {aiAgents.length > 0 ? (
                <div class="grid gap-4 sm:grid-cols-2">
                    {aiAgents.map((project) => (
                        <ProjectCard project={project} />
                    ))}
                </div>
            ) : (
                <p class="text-text-muted text-sm mt-4">Coming soon.</p>
            )}
        </div>

        <!-- DSA -->
        <div id="tab-dsa" class="tab-panel mt-6 hidden">
            {dsaProjects.length > 0 ? (
                <div class="grid gap-4 sm:grid-cols-2">
                    {dsaProjects.map((project) => (
                        <ProjectCard project={project} />
                    ))}
                </div>
            ) : (
                <p class="text-text-muted text-sm mt-4">Coming soon.</p>
            )}
        </div>

        <!-- Other -->
        <div id="tab-other" class="tab-panel mt-6 hidden">
            {otherProjects.length > 0 ? (
                <div class="grid gap-4 sm:grid-cols-2">
                    {otherProjects.map((project) => (
                        <ProjectCard project={project} />
                    ))}
                </div>
            ) : (
                <p class="text-text-muted text-sm mt-4">Coming soon.</p>
            )}
        </div>
    </main>
</Layout>

<script>
    const languageColors: Record<string, string> = {
        TypeScript: '#3178c6',
        JavaScript: '#f1e05a',
        Python: '#3572A5',
        Go: '#00ADD8',
        Rust: '#dea584',
        'C++': '#f34b7d',
        'C#': '#178600',
        Java: '#b07219',
        HTML: '#e34c26',
        CSS: '#563d7c',
        Astro: '#ff5a03',
        Shell: '#89e051',
        Ruby: '#701516',
        'Jupyter Notebook': '#DA5B0B',
        Lua: '#000080',
        Nix: '#7e7eff',
    };

    async function loadCurrentRepo() {
        try {
            const eventsRes = await fetch('https://api.github.com/users/kidskoding/events/public?per_page=100');
            const events: any[] = await eventsRes.json();
            const pushEvent = events.find((e: any) => e.type === 'PushEvent');
            if (!pushEvent) return;

            const repoRes = await fetch(`https://api.github.com/repos/${pushEvent.repo.name}`);
            const repo: any = await repoRes.json();

            const langColor = repo.language ? (languageColors[repo.language] ?? '#8b949e') : null;
            const langDot = langColor
                ? `<span class="flex items-center gap-1.5 text-xs text-text-muted">
                     <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color:${langColor}"></span>
                     ${repo.language}
                   </span>`
                : '';

            const card = document.getElementById('current-repo-card');
            if (card) {
                card.innerHTML = `
                    <a href="${repo.html_url}" target="_blank" rel="noopener noreferrer"
                       class="glow-card flex flex-col p-5 transition-all duration-300 hover:bg-bg-card-hover group">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center gap-2 min-w-0">
                                <svg class="w-4 h-4 text-text-muted shrink-0" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.412-4.041-1.412-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                                <span class="text-sm font-semibold text-accent group-hover:underline truncate">${repo.name}</span>
                            </div>
                            <svg class="w-4 h-4 text-text-muted shrink-0 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                            </svg>
                        </div>
                        ${repo.description ? `<p class="text-sm text-text-secondary mt-2 leading-relaxed line-clamp-2">${repo.description}</p>` : ''}
                        <div class="flex flex-wrap items-center gap-3 mt-auto pt-4">${langDot}</div>
                    </a>`;

                // wire up glow effect
                const a = card.querySelector('a');
                if (a) {
                    a.addEventListener('mousemove', (e) => {
                        const rect = a.getBoundingClientRect();
                        a.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
                        a.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
                    });
                }
            }

            const wrapper = document.getElementById('currently-working-on');
            if (wrapper) wrapper.classList.remove('hidden');
        } catch (_) {}
    }

    loadCurrentRepo();
    document.addEventListener('astro:after-swap', loadCurrentRepo);
</script>

<script>
    function initTabs() {
        const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
        const panels = document.querySelectorAll<HTMLElement>('.tab-panel');

        function activate(tab: string) {
            buttons.forEach((btn) => {
                const isActive = btn.dataset.tab === tab;
                btn.classList.toggle('text-accent', isActive);
                btn.classList.toggle('border-accent', isActive);
                btn.classList.toggle('text-text-muted', !isActive);
                btn.classList.toggle('border-transparent', !isActive);
            });
            panels.forEach((panel) => {
                panel.classList.toggle('hidden', panel.id !== `tab-${tab}`);
            });
        }

        buttons.forEach((btn) => {
            btn.addEventListener('click', () => activate(btn.dataset.tab!));
        });

        activate('featured');
    }

    initTabs();
    document.addEventListener('astro:after-swap', initTabs);
</script>
