---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import Layout from '../layouts/Layout.astro';
import { byProjectOrderThenDate } from '../data/project-sort';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const tabs = [
  { key: 'projects', label: 'projects', category: 'project' },
  { key: 'hackathons', label: 'hackathons', category: 'hackathon' },
  { key: 'agentic', label: 'agentic ai @ uiuc work samples', category: 'agentic' },
] as const;
const groups = tabs.map((tab) => ({
  ...tab,
  items: projects.filter((project) => project.data.category === tab.category).sort(byProjectOrderThenDate),
}));
---

<Layout title="Projects">
  <main class="mx-auto w-full max-w-3xl px-6 py-8" id="main-content">
    <div data-animate>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-accent">Projects</p>
      <h1 class="gradient-text text-4xl font-bold tracking-tight md:text-5xl">Projects</h1>
      <p class="mt-3 max-w-md text-base text-text-muted">things i've built. click a tile, or press ? for keys</p>
    </div>

    <div class="mt-10 flex gap-2 overflow-x-auto border-b border-border-subtle" role="tablist" aria-label="Project categories" data-animate>
      {groups.map((group, index) => (
        <button class="tab-btn -mb-px whitespace-nowrap border-b-2 px-4 py-2.5 text-sm font-medium transition-colors duration-200" type="button" role="tab" data-tab={group.key} aria-controls={`tab-${group.key}`} aria-selected={index === 0 ? 'true' : 'false'} title={`Switch to tab ${index + 1}`}>
          {group.label}
        </button>
      ))}
    </div>

    <label class="mt-4 flex min-w-0 items-center gap-2 border border-border-subtle bg-bg-secondary px-3 py-2 font-mono" data-animate>
      <span class="font-bold text-nvim-red" aria-hidden="true">&gt;</span>
      <input class="min-w-0 flex-1 border-0 bg-transparent text-sm text-text-primary outline-none placeholder:text-nvim-gray" id="project-filter" type="search" placeholder="filter tiles..." autocomplete="off" spellcheck="false" aria-label="Filter projects" />
    </label>

    {groups.map((group, index) => (
      <div id={`tab-${group.key}`} class:list={['tab-panel mt-6', { hidden: index !== 0 }]} role="tabpanel">
        <div class="grid gap-4 sm:grid-cols-2">
          {group.items.map((project) => <ProjectCard project={project} />)}
        </div>
        <p class="no-matches mt-4 hidden text-sm text-text-muted">no matches</p>
      </div>
    ))}

    <p class="mt-10 text-sm" data-animate>
      <a href="https://github.com/kidskoding" target="_blank" rel="noopener noreferrer" class="text-nvim-blue hover:underline">more on github &rarr;</a>
    </p>

    <div id="gallery-status" class="mt-8 flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1 bg-nvim-bg3 px-3 py-1 font-mono text-xs text-text-primary" aria-live="polite">
      <span class="shrink-0 font-bold text-nvim-aqua">-- NORMAL --</span>
      <span class="min-w-0 break-all" id="status-file"></span>
      <span class="shrink-0 text-nvim-gray" id="status-count"></span>
      <button class="ml-auto shrink-0 text-nvim-gray hover:text-text-primary" id="gallery-help" type="button" aria-controls="gallery-keys" aria-expanded="false">press ? for keys</button>
    </div>

    <div id="gallery-keys" class="mt-2 border border-border-subtle bg-bg-secondary px-4 py-3 font-mono text-xs" hidden>
      <div class="mb-2 font-bold text-nvim-green">keys</div>
      <dl class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-x-3 gap-y-1">
        <dt class="text-nvim-yellow">h j k l</dt><dd class="text-text-secondary">move cursor</dd>
        <dt class="text-nvim-yellow">enter</dt><dd class="text-text-secondary">open tile</dd>
        <dt class="text-nvim-yellow">gg / G</dt><dd class="text-text-secondary">first / last</dd>
        <dt class="text-nvim-yellow">1 2 3</dt><dd class="text-text-secondary">switch tab</dd>
        <dt class="text-nvim-yellow">/</dt><dd class="text-text-secondary">filter</dd>
        <dt class="text-nvim-yellow">esc</dt><dd class="text-text-secondary">clear filter</dd>
        <dt class="text-nvim-yellow">?</dt><dd class="text-text-secondary">toggle this</dd>
      </dl>
    </div>
  </main>
</Layout>

<style>
  .tab-btn[aria-selected='true'] { color: var(--color-nvim-green); border-color: var(--color-nvim-yellow); }
  .tab-btn[aria-selected='false'] { color: var(--color-text-muted); border-color: transparent; }
</style>

<script>
  let galleryController: AbortController | undefined;

  function initGallery() {
    galleryController?.abort();
    galleryController = undefined;

    const main = document.getElementById('main-content');
    const filter = document.getElementById('project-filter') as HTMLInputElement | null;
    const statusFile = document.getElementById('status-file');
    const statusCount = document.getElementById('status-count');
    const keysPanel = document.getElementById('gallery-keys');
    const help = document.getElementById('gallery-help');
    if (!main || !filter || !statusFile || !statusCount || !keysPanel || !help) return;

    const controller = new AbortController();
    galleryController = controller;
    const listener = { signal: controller.signal };
    let cursor = 0;
    let pendingG = false;
    let pendingGTimer: number | undefined;

    const activePanel = () => main.querySelector<HTMLElement>('.tab-panel:not(.hidden)');
    const visibleTiles = () => [...(activePanel()?.querySelectorAll<HTMLElement>('[data-tile]') ?? [])].filter((tile) => !tile.hidden);

    function paint() {
      const tiles = visibleTiles();
      main.querySelectorAll('.tile-cursor').forEach((tile) => tile.classList.remove('tile-cursor'));
      if (!tiles.length) {
        statusFile.textContent = '';
        statusCount.textContent = '0/0';
        return;
      }
      cursor = Math.max(0, Math.min(cursor, tiles.length - 1));
      const tile = tiles[cursor];
      tile.classList.add('tile-cursor');
      statusFile.textContent = `projects/${tile.dataset.slug}.mdx`;
      statusCount.textContent = `${cursor + 1}/${tiles.length}`;
    }

    function applyFilter() {
      const query = filter.value.trim().toLowerCase();
      const panel = activePanel();
      if (!panel) return;
      let shown = 0;
      panel.querySelectorAll<HTMLElement>('[data-tile]').forEach((tile) => {
        const matches = !query || (tile.dataset.search ?? '').includes(query);
        tile.hidden = !matches;
        if (matches) shown += 1;
      });
      panel.querySelector<HTMLElement>('.no-matches')?.classList.toggle('hidden', shown > 0 || !query);
      cursor = 0;
      paint();
    }

    function activateTab(tab: string) {
      main.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((button) => {
        const active = button.dataset.tab === tab;
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
      });
      main.querySelectorAll<HTMLElement>('.tab-panel').forEach((panel) => panel.classList.toggle('hidden', panel.id !== `tab-${tab}`));
      filter.value = '';
      applyFilter();
    }

    // Mouse users leave focus on a tab or the help button; vim motions should
    // reclaim it so Enter opens the cursor tile instead of re-firing that button.
    function releaseButtonFocus() {
      const active = document.activeElement as HTMLElement | null;
      if (active && active !== document.body && active.closest('.tab-btn, #gallery-help')) active.blur();
    }

    function move(delta: number) {
      releaseButtonFocus();
      const tiles = visibleTiles();
      if (!tiles.length) return;
      cursor = Math.max(0, Math.min(tiles.length - 1, cursor + delta));
      paint();
      visibleTiles()[cursor]?.scrollIntoView({ block: 'nearest' });
    }

    function columns() {
      const tiles = visibleTiles();
      if (tiles.length < 2) return 1;
      const firstTop = tiles[0].offsetTop;
      const nextRow = tiles.findIndex((tile, index) => index > 0 && tile.offsetTop > firstTop);
      return nextRow < 0 ? tiles.length : nextRow;
    }

    function toggleHelp() {
      keysPanel.hidden = !keysPanel.hidden;
      help.setAttribute('aria-expanded', String(!keysPanel.hidden));
    }

    main.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((button) => button.addEventListener('click', () => activateTab(button.dataset.tab ?? 'projects'), listener));
    main.addEventListener('mouseover', (event) => {
      const tile = (event.target as HTMLElement).closest<HTMLElement>('[data-tile]');
      const index = tile ? visibleTiles().indexOf(tile) : -1;
      if (index >= 0 && index !== cursor) { cursor = index; paint(); }
    }, listener);
    main.addEventListener('focusin', (event) => {
      const tile = (event.target as HTMLElement).closest<HTMLElement>('[data-tile]');
      const index = tile ? visibleTiles().indexOf(tile) : -1;
      if (index >= 0) { cursor = index; paint(); }
    }, listener);
    filter.addEventListener('input', applyFilter, listener);
    filter.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        filter.value = '';
        applyFilter();
        filter.blur();
      } else if (event.key === 'Enter') {
        visibleTiles()[cursor]?.click();
      }
    }, listener);
    help.addEventListener('click', toggleHelp, listener);

    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      const typing = target.matches('input, textarea') || target.isContentEditable;
      const nativeEnter = event.key === 'Enter' && Boolean(target.closest('a, button'));
      const telescopeOpen = document.getElementById('telescope')?.classList.contains('open');
      if (typing || nativeEnter || telescopeOpen || event.metaKey || event.ctrlKey || event.altKey) return;

      switch (event.key) {
        case 'h': case 'ArrowLeft': event.preventDefault(); move(-1); break;
        case 'l': case 'ArrowRight': event.preventDefault(); move(1); break;
        case 'j': case 'ArrowDown': event.preventDefault(); move(columns()); break;
        case 'k': case 'ArrowUp': event.preventDefault(); move(-columns()); break;
        case 'Enter': event.preventDefault(); visibleTiles()[cursor]?.click(); break;
        case 'G': event.preventDefault(); releaseButtonFocus(); cursor = visibleTiles().length - 1; paint(); break;
        case 'g':
          if (pendingG) {
            releaseButtonFocus();
            cursor = 0;
            paint();
            pendingG = false;
            window.clearTimeout(pendingGTimer);
          } else {
            pendingG = true;
            pendingGTimer = window.setTimeout(() => { pendingG = false; }, 600);
          }
          break;
        case '1': case '2': case '3': main.querySelectorAll<HTMLButtonElement>('.tab-btn')[Number(event.key) - 1]?.click(); break;
        case '/': event.preventDefault(); filter.focus(); break;
        case 'Escape': filter.value = ''; applyFilter(); break;
        case '?': event.preventDefault(); toggleHelp(); break;
      }
    }, listener);

    activateTab('projects');
  }

  initGallery();
  document.addEventListener('astro:page-load', initGallery);
</script>
