	Scrum: { id: "ph:users-three", color: "#A1A1AA" },
	Kanban: { id: "ph:kanban", color: "#A1A1AA" },
	"Test Driven Development": { id: "ph:flask", color: "#A1A1AA" },
	"CI/CD": { id: "ph:infinity", color: "#A1A1AA" },
	MonoGame: { id: "simple-icons:monogame", color: "#E73C00" },
	Godot: { id: "simple-icons:godotengine", color: "#478CBF" },
};

const iconSets: Record<string, typeof simpleIcons> = {
	"simple-icons": simpleIcons,
	ph: phIcons,
};

function getSvg(id: string, color: string): string | undefined {
	const [prefix, name] = id.split(":");
	const set = iconSets[prefix];
	if (!set) return undefined;
	const data = getIconData(set, name);
	if (!data) return undefined;
	const rendered = iconToSVG(data);
	return iconToHTML(rendered.body, {
		...rendered.attributes,
		style: `color: ${color}; fill: currentColor`,
	});
}

const svgCache: Record<string, string> = {};
for (const [name, { id, color }] of Object.entries(iconMap)) {
	const svg = getSvg(id, color);
	if (svg) svgCache[name] = svg;
}
svgCache["Pygame"] = `<img src="${pygameImage.src}" alt="Pygame logo" />`;
svgCache["Workday"] = `<img src="${workdayIcon.src}" alt="Workday logo" />`;
svgCache["ServiceNow"] = `<img src="${servicenowIcon.src}" alt="ServiceNow logo" />`;

const skillGroups = [
