	MCP: { id: "ph:cube", color: "#A1A1AA" },
	React: { id: "simple-icons:react", color: "#61DAFB" },
	Next: { id: "simple-icons:nextdotjs", color: "#FFFFFF" },
	"Node.js": { id: "simple-icons:nodedotjs", color: "#339933" },
	Angular: { id: "simple-icons:angular", color: "#DD0031" },
	Astro: { id: "simple-icons:astro", color: "#FF5D01" },
