---

<Layout title="Skills">
	<Navigation currentPage="skills" />
	<main class="max-w-6xl mx-auto px-6 py-12">
		<h1 class="text-3xl font-bold text-text-primary tracking-tight">Skills</h1>
		<p class="text-text-secondary mt-3 max-w-2xl">
			A snapshot of the tools, languages, and platforms I use to build products.
		</p>

		<div class="mt-10 space-y-10">
			{skillGroups.map((group) => (
				<section>
					<h2 class="text-lg font-semibold text-text-primary">{group.title}</h2>
					<div class="mt-4 grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-3">
						{group.skills.map((skill) => {
							const icon = iconMap[skill];
							const containerClass = icon
								? "rounded-md border border-border-subtle bg-bg-card p-3 flex flex-col items-center justify-center gap-2.5 aspect-square text-center"
								: "rounded-md border border-border-subtle bg-bg-card p-3 flex flex-col items-start justify-start gap-2.5 aspect-square text-left";
							return (
								<div class={containerClass} data-animate>
									{icon ? (
										<span class="w-9 h-9 rounded-md flex items-center justify-center bg-white/8 ring-1 ring-white/12 backdrop-blur-sm">
											<img
												src={iconUrl(icon.id, icon.color)}
												alt={`${skill} icon`}
												class="w-10 h-10 drop-shadow-[0_0_2px_rgba(255,255,255,0.7)] drop-shadow-[0_1px_6px_rgba(0,0,0,0.35)]"
												loading="lazy"
											/>
										</span>
									) : null}
									<span class="text-md font-semibold text-text-primary leading-snug">{skill}</span>
								</div>
							);
						})}
					</div>
				</section>
			))}
		</div>
	</main>
</Layout>
