		skills: [
			"React",
			"Next",
			"Node.js",
			"Angular",
			"Astro",
			"Chart.js",
			"Express",
			"Django",
			"FastAPI",
			"Flask"
		]
	},
	{
		title: "Game Development",
		skills: [
			"Unity",
			"Unreal",
			"Godot",
			"Pygame",
			"MonoGame"
		]
	},
	{
		title: "Databases",
		skills: [
			"PostgreSQL",
			"MongoDB",
			"MySQL",
			"Cassandra",
			"Redis",
			"Apache Spark",
			"Databricks",
			"Pinecone",
			"Qdrant"
		]
	},
	{
		title: "Developer Tools",
		skills: [
			"GNU/Linux",
			"Git",
			"GitHub",
			"Docker",
			"Kubernetes",
			"Kafka",
			"Selenium",
			"Power BI",
			"Tableau",
			"Stripe"
		]
	},
	{
		title: "Cloud Platforms",
		skills: [
			"Google Cloud Platform",
			"Amazon Web Services",
			"Microsoft Azure"
		]
	},
	{
		title: "Vibecoding",
		skills: [
			"Cursor",
			"Claude Code",
			"Lovable",
			"Bolt",
			"Replit",
			"Windsurf"
		]
	},
	{
		title: "Methodologies",
		skills: [
			"Agile",
			"Scrum",
			"Kanban",
			"Test Driven Development",
			"CI/CD"
		]
	}
];
---

<Layout title="Skills">
	<Navigation currentPage="skills" />
	<main class="max-w-3xl mx-auto px-6 py-12">
		<div class="skill-fade" style="--delay: 0">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-3">Toolkit</p>
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight gradient-text">Skills</h1>
			<p class="text-text-muted mt-3 text-base max-w-md">
				the tools, languages, and platforms I use to build products
			</p>
		</div>

		<section class="mt-[3.75rem] mb-[3.75rem] text-center skill-fade" style="--delay: 1">
			<h2 class="text-lg font-semibold text-text-primary">Daily Drivers</h2>
			<p class="text-text-secondary mt-1 text-sm">The tools I yearn for <b>every day</b></p>
			<div class="mt-4 flex flex-wrap justify-center gap-4">
				{["Python", "Claude Code", "Cursor", "Git", "Docker", "Google Cloud Platform", "GitHub", "Rust", "Go", "PostgreSQL", "MongoDB", "Databricks", "Stripe"].map((skill) => (
					<div class="w-[calc((100%-3*1rem)/4)] sm:w-[calc((100%-4*1rem)/5)] min-w-0 shrink-0">
						<SkillCard
							name={skill}
							svg={svgCache[skill]}
						/>
					</div>
				))}
			</div>
		</section>

		<div class="mt-10 space-y-10">
			{skillGroups.map((group, i) => (
				<section class="skill-fade" style={`--delay: ${i + 2}`}>
					<h2 class="text-lg font-semibold text-text-primary">{group.title}</h2>
					<div class="mt-4 grid grid-cols-4 sm:grid-cols-5 gap-4">
						{group.skills.map((skill) => {
							return (
								<SkillCard
									name={skill}
									svg={svgCache[skill]}
									hideIcon={!svgCache[skill]}
								/>
							);
						})}
					</div>
				</section>
			))}
		</div>
	</main>
</Layout>

<style>
	.skill-fade {
		opacity: 0;
		transform: translateY(24px);
		animation: skillFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		animation-delay: calc(var(--delay) * 0.12s);
	}

	@keyframes skillFadeIn {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.skill-fade {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}
</style>
