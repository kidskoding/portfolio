const iconUrl = (id: string, color: string) =>
	`https://api.iconify.design/${id}.svg?color=${encodeURIComponent(color)}`;

const iconFor = (name: string) =>
	name
		.split(/[^A-Za-z0-9]+/)
		.filter(Boolean)
		.map((part) => part[0])
		.join("")
		.slice(0, 2)
		.toUpperCase();

const skillGroups = [
	{
		title: "Programming Languages",
		skills: [
			"C",
			"C++",
			"Rust",
			"Python",
			"Go",
			"C#",
			"Java",
			"HTML/CSS",
			"Tailwind CSS",
