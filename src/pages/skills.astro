	MongoDB: { id: "simple-icons:mongodb", color: "#47A248" },
	MySQL: { id: "simple-icons:mysql", color: "#4479A1" },
	Cassandra: { id: "simple-icons:apachecassandra", color: "#1287B1" },
	Redis: { id: "simple-icons:redis", color: "#DC382D" },
	"Apache Spark": { id: "simple-icons:apachespark", color: "#E25A1C" },
	Databricks: { id: "simple-icons:databricks", color: "#FF3621" },
	Pinecone: { id: "ph:tree-evergreen-fill", color: "#30B8A2" },
	Qdrant: { id: "ph:crosshair-fill", color: "#DC244C" },
	"GNU/Linux": { id: "simple-icons:linux", color: "#FCC624" },
	Git: { id: "simple-icons:git", color: "#F05032" },
	GitHub: { id: "simple-icons:github", color: "#FFFFFF" },
	Docker: { id: "simple-icons:docker", color: "#2496ED" },
	Kubernetes: { id: "simple-icons:kubernetes", color: "#326CE5" },
	Kafka: { id: "simple-icons:apachekafka", color: "#FFFFFF" },
	Selenium: { id: "simple-icons:selenium", color: "#43B02A" },
	"Power BI": { id: "simple-icons:powerbi", color: "#F2C811" },
	Tableau: { id: "simple-icons:tableau", color: "#E97627" },
	Stripe: { id: "simple-icons:stripe", color: "#008CDD" },
	"Claude Code": { id: "simple-icons:claude", color: "#D4A574" },
	Cursor: { id: "simple-icons:cursor", color: "#FFFFFF" },
	Lovable: { id: "ph:heart-fill", color: "#EC4899" },
	Bolt: { id: "simple-icons:stackblitz", color: "#1389FD" },
	Replit: { id: "simple-icons:replit", color: "#F26207" },
	Windsurf: { id: "ph:wind", color: "#22D3EE" },
	"Google Cloud Platform": { id: "simple-icons:googlecloud", color: "#FBBC05" },
	"Amazon Web Services": { id: "simple-icons:amazonaws", color: "#FF9900" },
	"Microsoft Azure": { id: "simple-icons:microsoftazure", color: "#0078D4" },
	Agile: { id: "ph:timer", color: "#A1A1AA" },
	Scrum: { id: "ph:users-three", color: "#A1A1AA" },
	Kanban: { id: "ph:kanban", color: "#A1A1AA" },
	"Test Driven Development": { id: "ph:flask", color: "#A1A1AA" },
	"CI/CD": { id: "ph:infinity", color: "#A1A1AA" },
	MonoGame: { id: "simple-icons:monogame", color: "#E73C00" },
	Godot: { id: "simple-icons:godotengine", color: "#478CBF" },
};

const iconSets: Record<string, typeof simpleIcons> = {
	"simple-icons": simpleIcons,
	ph: phIcons,
};

function getSvg(id: string, color: string): string | undefined {
	const [prefix, name] = id.split(":");
	const set = iconSets[prefix];
	if (!set) return undefined;
	const data = getIconData(set, name);
	if (!data) return undefined;
	const rendered = iconToSVG(data);
	return iconToHTML(rendered.body, {
		...rendered.attributes,
		style: `color: ${color}; fill: currentColor`,
	});
}

const svgCache: Record<string, string> = {};
for (const [name, { id, color }] of Object.entries(iconMap)) {
	const svg = getSvg(id, color);
	if (svg) svgCache[name] = svg;
}
svgCache["Pygame"] = `<img src="${pygameImage.src}" alt="Pygame logo" />`;

const skillGroups = [
	{
		title: "Programming Languages",
		skills: [
			"C",
			"C++",
			"Rust",
			"Python",
			"Go",
			"C#",
			"Java",
