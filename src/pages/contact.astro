---
import Layout from '../layouts/Layout.astro';
import devToIcon from '../assets/fi-swluxl-dev-to.png';

const contactLinks = [
  {
    name: "Email",
    href: "mailto:ak123@illinois.edu",
    description: "ak123@illinois.edu",
    icon: "mail",
    external: false
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/anirudh-konidala",
    description: "connect with me on LinkedIn!",
    icon: "linkedin",
    external: true
  },
  {
    name: "GitHub",
    href: "https://github.com/kidskoding",
    description: "check out my GitHub!",
    icon: "github",
    external: true
  },
  {
    name: "DEV",
    href: "https://dev.to/anikoni2010",
    description: "check out my DEV blog posts!",
    icon: "dev",
    external: true
  }
];

const linkedInPath = "M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z";
const githubPath = "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.412-4.041-1.412-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z";
const mailPath = "M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z";
---

<Layout title="Contact">
    <main class="max-w-3xl w-full mx-auto px-6 py-8" id="main-content">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-3" data-animate>Contact</p>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight gradient-text" data-animate>Contact</h1>
        <p class="text-text-muted mt-3 text-base max-w-md" data-animate>
            contact me if you want to stay in touch! collaboration, questions, or just simply saying hi :)
        </p>

        <section class="mt-10" data-animate>
            <div class="grid gap-4 sm:grid-cols-2">
                {contactLinks.map((item) => (
                    <a
                        href={item.href}
                        target={item.external ? "_blank" : undefined}
                        rel={item.external ? "noopener noreferrer" : undefined}
                        class="group flex items-center gap-4 rounded-xl border border-border-subtle bg-bg-card p-5 transition-all hover:border-accent/40 hover:bg-bg-card-hover"
                    >
                        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/5 ring-1 ring-white/10 transition-colors group-hover:ring-accent/30 {item.icon === 'mail' ? 'text-sky-400' : item.icon === 'linkedin' ? 'text-[#0A66C2]' : item.icon === 'github' ? 'text-white' : 'text-text-muted'} group-hover:text-accent">
                            {item.icon === "mail" && (
                                <svg class="h-6 w-6 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d={mailPath} />
                                </svg>
                            )}
                            {item.icon === "linkedin" && (
                                <svg class="h-6 w-6 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="color: #0A66C2">
                                    <path d={linkedInPath} />
                                </svg>
                            )}
                            {item.icon === "github" && (
                                <svg class="h-6 w-6 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d={githubPath} />
                                </svg>
                            )}
                            {item.icon === "dev" && (
                                <img src={devToIcon.src} alt="" class="h-6 w-6 shrink-0" />
                            )}
                        </span>
                        <div class="min-w-0 flex-1">
                            <p class="font-semibold text-text-primary group-hover:text-accent transition-colors">{item.name}</p>
                            <p class="text-sm text-text-muted truncate">{item.description}</p>
                        </div>
                        <span class="shrink-0 text-text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent" aria-hidden="true">→</span>
                    </a>
                ))}
            </div>
        </section>
    </main>
</Layout>
