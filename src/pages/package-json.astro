---
import Layout from '../layouts/Layout.astro';
import pkg from '../../package.json';

const esc = (v: string) => v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const k = (s: string) => `<span class="j-key">"${esc(s)}"</span>`;
const s = (s: string) => `<span class="j-str">"${esc(s)}"</span>`;
const p = (s: string) => `<span class="j-punct">${s}</span>`;

// The real package.json, read at build time and laid out the way JSON.stringify(pkg, null, 2) writes it,
// so the buffer always shows the versions the site is actually built with
function render(value: unknown, depth: number): string {
  if (typeof value === 'string') return s(value);
  if (value === null || typeof value !== 'object') return esc(String(value));
  const indent = '  '.repeat(depth + 1);
  const close = '  '.repeat(depth);
  const isArray = Array.isArray(value);
  const entries = isArray ? value.map((v) => [null, v] as const) : Object.entries(value);
  if (!entries.length) return p(isArray ? '[]' : '{}');
  const lines = entries.map(
    ([key, v], i) =>
      `${indent}${key === null ? '' : `${k(key)}${p(':')} `}${render(v, depth + 1)}${i < entries.length - 1 ? p(',') : ''}`,
  );
  return [p(isArray ? '[' : '{'), ...lines, `${close}${p(isArray ? ']' : '}')}`].join('\n');
}

const content = render(pkg, 0);
---

<Layout title="package.json">
  <main class="pkg-wrap" id="main-content">
    <pre class="pkg-pre" data-animate><code set:html={content} /></pre>
  </main>
</Layout>

<style>
  .pkg-wrap {
    padding: 1.5rem 2rem;
    height: 100%;
    overflow: auto;
  }

  .pkg-pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-nvim-fg);
    background: transparent;
    white-space: pre;
  }

  :global(.j-key) {
    color: var(--color-nvim-blue);
  }
  :global(.j-str) {
    color: var(--color-nvim-green);
  }
  :global(.j-punct) {
    color: var(--color-nvim-fg2);
  }
</style>
